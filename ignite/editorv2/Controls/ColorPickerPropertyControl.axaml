<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:IgniteEditor.Controls"
             x:Class="IgniteEditor.Controls.ColorPickerPropertyControl"
             x:Name="Root"
             HorizontalAlignment="Stretch">

    <Grid ColumnDefinitions="60,34,*,18" Margin="0,1" HorizontalAlignment="Stretch">
        <!-- Label -->
        <TextBlock Grid.Column="0" Text="{Binding Label, ElementName=Root}"
                   FontSize="11" Foreground="#9E9E9E" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" />

        <!-- Color Swatch Button with Flyout Popover -->
        <Button Grid.Column="1" Height="20" Padding="0" Margin="0,0,4,0"
                BorderThickness="1" BorderBrush="#444444" CornerRadius="3"
                Background="{Binding SwatchBrush, ElementName=Root}"
                ToolTip.Tip="Click to open Photoshop Color Picker">
            <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedLeft">
                    <local:ColorPickerControl x:Name="Picker"
                        SelectedColor="{Binding Value, ElementName=Root, Mode=TwoWay}"
                        ColorChanged="OnPickerColorChanged" />
                </Flyout>
            </Button.Flyout>
        </Button>

        <!-- Hex String TextBox -->
        <TextBox Grid.Column="2" Text="{Binding HexString, ElementName=Root}"
                 FontSize="11" Height="20" MinHeight="20" Padding="4,1"
                 FontFamily="Consolas,Menlo,monospace" VerticalContentAlignment="Center"
                 LostFocus="OnHexLostFocus" KeyDown="OnHexKeyDown" />

        <!-- Reset Button -->
        <Button Grid.Column="3" Classes="reset-btn"
                Width="16" Height="16" Padding="0" Margin="2,0,0,0"
                ToolTip.Tip="Reset to default color"
                IsVisible="{Binding HasChanged, ElementName=Root}"
                Click="OnResetClicked">
            <TextBlock Text="↺" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Button>
    </Grid>
</UserControl>
