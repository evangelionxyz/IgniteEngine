<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:IgniteEditor.ViewModels"
             x:Class="IgniteEditor.Views.Panels.ContentBrowserPanel"
             x:DataType="vm:ContentBrowserViewModel">

    <DockPanel>
        <!-- Navigation bar -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto" Margin="2" Height="26">
            <Button Grid.Column="0" Content="◀" Command="{Binding NavigateBackCommand}" 
                    IsEnabled="{Binding CanGoBack}" Padding="4,2" FontSize="11" MinWidth="24" MinHeight="22" />
            <Button Grid.Column="1" Content="▶" Command="{Binding NavigateForwardCommand}" 
                    IsEnabled="{Binding CanGoForward}" Padding="4,2" FontSize="11" MinWidth="24" MinHeight="22" Margin="2,0" />
            <Button Grid.Column="2" Content="▲" Command="{Binding NavigateUpCommand}" 
                    Padding="4,2" FontSize="11" MinWidth="24" MinHeight="22" Margin="0,0,4,0" />
            
            <!-- Breadcrumbs -->
            <ItemsControl Grid.Column="3" ItemsSource="{Binding Breadcrumbs}" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="0" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:BreadcrumbSegment">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{Binding Name}" 
                                    Classes="breadcrumb"
                                    FontSize="11" Padding="2,1" MinHeight="20"
                                    Background="Transparent" BorderThickness="0" />
                            <TextBlock Text="›" Foreground="#808080" FontSize="12" VerticalAlignment="Center" Margin="2,0" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBox Grid.Column="4" PlaceholderText="🔍 Search" Text="{Binding SearchFilter}" 
                     Width="140" FontSize="11" Padding="4,2" MinHeight="22" Margin="4,0" />

            <Slider Grid.Column="5" Value="{Binding ThumbnailSize}" Minimum="48" Maximum="128" 
                    Width="80" VerticalAlignment="Center" />
        </Grid>

        <!-- Item count status -->
        <Border DockPanel.Dock="Bottom" Padding="4,2" Height="20">
            <TextBlock FontSize="10" Foreground="#808080" VerticalAlignment="Center">
                <TextBlock.Text>
                    <MultiBinding StringFormat="{}{0} items">
                        <Binding Path="Items.Count" />
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
        </Border>

        <!-- Main content area -->
        <Grid ColumnDefinitions="180,4,*">
            <!-- Directory tree -->
            <TreeView Grid.Column="0" ItemsSource="{Binding DirectoryTree}" Padding="2" FontSize="11">
                <TreeView.ItemTemplate>
                    <TreeDataTemplate ItemsSource="{Binding Children}" x:DataType="vm:DirectoryNodeViewModel">
                        <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,1">
                            <TextBlock Text="📁" FontSize="12" />
                            <TextBlock Text="{Binding Name}" FontSize="11" VerticalAlignment="Center" />
                        </StackPanel>
                    </TreeDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>

            <GridSplitter Grid.Column="1" Width="3" Background="#2A2A2A" />

            <!-- File grid -->
            <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Items}" Padding="4">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:FileItemViewModel">
                            <Button Background="Transparent" BorderThickness="0" 
                                    Padding="4" Margin="2"
                                    Command="{Binding $parent[ItemsControl].((vm:ContentBrowserViewModel)DataContext).OpenItemCommand}"
                                    CommandParameter="{Binding}">
                                <StackPanel Width="72" Spacing="2">
                                    <Border Background="#252525" BorderBrush="#2F2F2F" BorderThickness="1" CornerRadius="4" 
                                            Width="64" Height="64"
                                            HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding IconGlyph}" 
                                                   FontSize="28" 
                                                   HorizontalAlignment="Center" 
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{Binding Name}" 
                                               FontSize="10" 
                                               TextTrimming="CharacterEllipsis" 
                                               TextAlignment="Center"
                                               MaxWidth="72" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
