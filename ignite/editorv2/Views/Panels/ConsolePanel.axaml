<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:IgniteEditor.ViewModels"
             xmlns:conv="using:IgniteEditor.Converters"
             x:Class="IgniteEditor.Views.Panels.ConsolePanel"
             x:DataType="vm:ConsoleViewModel">

    <UserControl.Resources>
        <conv:LogLevelToBrushConverter x:Key="LogLevelBrush" />
    </UserControl.Resources>

    <DockPanel>
        <!-- Toolbar -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="2" Margin="2" Height="26">
            <Button Content="Clear" Command="{Binding ClearCommand}" 
                    FontSize="11" Padding="6,2" MinHeight="22" />
            <Border Width="1" Background="#2E2E2E" Margin="4,2" />
            <ToggleButton Content="TRC" IsChecked="{Binding ShowTrace}" FontSize="10" Padding="4,2" MinHeight="22" />
            <ToggleButton Content="DBG" IsChecked="{Binding ShowDebug}" FontSize="10" Padding="4,2" MinHeight="22" />
            <ToggleButton Content="INF" IsChecked="{Binding ShowInfo}" FontSize="10" Padding="4,2" MinHeight="22" />
            <ToggleButton Content="WRN" IsChecked="{Binding ShowWarning}" FontSize="10" Padding="4,2" MinHeight="22" />
            <ToggleButton Content="ERR" IsChecked="{Binding ShowError}" FontSize="10" Padding="4,2" MinHeight="22" />
            <ToggleButton Content="CRT" IsChecked="{Binding ShowCritical}" FontSize="10" Padding="4,2" MinHeight="22" />
        </StackPanel>

        <!-- Command input -->
        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="2" Height="24">
            <TextBox Grid.Column="0" Text="{Binding CommandInput}" 
                     PlaceholderText="Enter command..." FontSize="11" Padding="4,2" MinHeight="22" />
            <Button Grid.Column="1" Content="Run" Command="{Binding ExecuteCommandCommand}" 
                    FontSize="11" Padding="6,2" MinHeight="22" Margin="2,0,0,0" />
        </Grid>

        <!-- Log entries -->
        <ListBox x:Name="LogListBox"
                 ItemsSource="{Binding FilteredLogs}" 
                 Padding="0" Margin="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:LogEntryViewModel">
                    <Grid ColumnDefinitions="80,70,*" Margin="2,1">
                        <TextBlock Grid.Column="0" Text="{Binding TimestampText}" 
                                   FontSize="11" 
                                   FontFamily="Consolas,monospace" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding LevelText}" 
                                   FontSize="11" Margin="4,1"
                                   Foreground="{Binding Level, Converter={StaticResource LogLevelBrush}}"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding Message}" 
                                   FontSize="11" TextWrapping="Wrap"
                                   Foreground="{Binding Level, Converter={StaticResource LogLevelBrush}}"
                                   VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
