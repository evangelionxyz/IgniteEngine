<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:IgniteEditor.ViewModels"
             xmlns:controls="using:IgniteEditor.Controls"
             xmlns:conv="using:IgniteEditor.Converters"
             x:Class="IgniteEditor.Views.Panels.ViewportPanel"
             x:DataType="vm:ViewportViewModel">

    <UserControl.Resources>
        <conv:CameraNavigationModeConverter x:Key="NavModeConverter" />
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,*" Background="#121212">
        <!-- Viewport Toolbar (Row 0) – outside native HWND bounds to prevent airspace clipping -->
        <Border Grid.Row="0" Background="#1A1A1A" BorderBrush="#2A2A2A" BorderThickness="0,0,0,1" Padding="6,3">
            <DockPanel LastChildFill="False">
                <!-- Navigation Mode dropdown (left) -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="Camera:" FontSize="11" Foreground="#888888" VerticalAlignment="Center" />
                    <ComboBox x:Name="NavModeComboBox"
                              ItemsSource="{Binding NavigationModes}"
                              SelectedItem="{Binding NavigationMode, Mode=TwoWay}"
                              FontSize="11"
                              Padding="6,2"
                              MinWidth="90"
                              Height="24"
                              Background="#252525"
                              BorderBrush="#3D3D3D"
                              BorderThickness="1"
                              CornerRadius="3"
                              IsEnabled="{Binding IsEngineConnected}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource NavModeConverter}}"
                                           Foreground="#C8C8C8" FontSize="11" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <!-- Viewport Info / FPS (right) -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                            IsVisible="{Binding IsEngineConnected}">
                    <TextBlock Text="Vulkan" FontSize="11" Foreground="#4EC9B0" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="|" FontSize="11" Foreground="#404040" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Fps, StringFormat='{}{0:F1} FPS'}" FontSize="11" Foreground="#A0A0A0" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Viewport Area (Row 1) -->
        <Grid Grid.Row="1" Background="#121212">
            <!-- Native Vulkan Viewport Host -->
            <controls:NativeViewportControl x:Name="ViewportHost"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch" />

            <!-- Overlay for status message when engine is not connected -->
            <Border Background="#CC121212"
                    IsVisible="{Binding !IsEngineConnected}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6">
                    <TextBlock Text="⬡" FontSize="44" Foreground="#383838" HorizontalAlignment="Center" />
                    <TextBlock Text="Viewport" FontSize="15" FontWeight="SemiBold" Foreground="#666666" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="#4A4A4A" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
