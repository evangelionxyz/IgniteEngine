<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chrome="using:Avalonia.Controls.Chrome">

    <!-- ========================================================================= -->
    <!-- IgniteEditor Compact Styling Overrides                                    -->
    <!-- Global density rules for game engine editor layout:                       -->
    <!--   - 12px Base Font (Inter)                                                -->
    <!--   - 2-4px Compact Padding                                                 -->
    <!--   - Tight Control MinHeights (20-24px)                                    -->
    <!--   - 8px Slim ScrollBars                                                   -->
    <!--   - 4px GridSplitters                                                     -->
    <!-- ========================================================================= -->

    <Styles.Resources>
        <!-- Font Family & Typography Tokens -->
        <FontFamily x:Key="ContentControlThemeFontFamily">avares://Avalonia.Fonts.Inter/Assets#Inter</FontFamily>
        <x:Double x:Key="ControlContentThemeFontSize">12</x:Double>

        <!-- Button Density Tokens -->
        <Thickness x:Key="ButtonPadding">8,4,8,4</Thickness>
        <x:Double x:Key="ButtonMinHeight">22</x:Double>

        <!-- TextBox & Input Density Tokens -->
        <Thickness x:Key="TextControlThemePadding">4,2,4,2</Thickness>
        <x:Double x:Key="TextControlThemeMinHeight">22</x:Double>

        <!-- TreeView Density Tokens -->
        <x:Double x:Key="TreeViewItemIndent">16</x:Double>
        <x:Double x:Key="TreeViewItemIndentSize">16</x:Double>
        <x:Double x:Key="TreeViewItemMinHeight">22</x:Double>

        <!-- ListBox Density Tokens -->
        <Thickness x:Key="ListBoxItemPadding">4,2,4,2</Thickness>
        <x:Double x:Key="ListBoxItemMinHeight">20</x:Double>

        <!-- Tab Density Tokens -->
        <Thickness x:Key="TabItemHeaderThemePadding">8,4,8,4</Thickness>
        <x:Double x:Key="TabItemMinHeight">24</x:Double>
        <x:Double x:Key="TabItemThemeFontSize">11</x:Double>

        <!-- Expander Density Tokens -->
        <x:Double x:Key="ExpanderMinHeight">16</x:Double>
        <Thickness x:Key="ExpanderHeaderPadding">2,2,2,2</Thickness>

        <!-- ScrollBar Density Tokens -->
        <x:Double x:Key="ScrollBarSize">8</x:Double>
        <x:Double x:Key="ScrollBarThickness">8</x:Double>

        <!-- Menu Density Tokens -->
        <Thickness x:Key="MenuFlyoutItemThemePadding">6,2,6,2</Thickness>
        <Thickness x:Key="MenuItemPadding">6,2,6,2</Thickness>
        <x:Double x:Key="MenuItemMinHeight">22</x:Double>
        <x:Double x:Key="MenuBarHeight">22</x:Double>

        <!-- ComboBox Density Tokens -->
        <Thickness x:Key="ComboBoxPadding">4,2,4,2</Thickness>
        <x:Double x:Key="ComboBoxMinHeight">22</x:Double>

        <!-- ToolTip Density Tokens -->
        <x:Double x:Key="ToolTipContentThemeFontSize">11</x:Double>

        <!-- Vector Icon Geometries for Crisp Toolbars & Panels -->
        <Geometry x:Key="IconPlay">M6 4l12 8-12 8V4z</Geometry>
        <Geometry x:Key="IconStop">M6 6h12v12H6z</Geometry>
        <Geometry x:Key="IconPause">M6 5h4v14H6zm8 0h4v14h-4z</Geometry>
        <Geometry x:Key="IconStep">M5 5v14l9-7zm10 0h3v14h-3z</Geometry>
        <Geometry x:Key="IconSimulate">M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 14.5v-9l6 4.5-6 4.5z</Geometry>
        <Geometry x:Key="IconSelect">M12 2a10 10 0 1 0 0 20 10 10 0 1 0 0-20zm0 2a8 8 0 1 1 0 16 8 8 0 0 1 0-16zm-1 3v4H7v2h4v4h2v-4h4v-2h-4V7h-2z</Geometry>
        <Geometry x:Key="IconTranslate">M10 2v6H4l4-4-1.4-1.4L1.2 8l5.4 5.4L8 12 4 8h6v6H4l4-4-1.4-1.4L1.2 14l5.4 5.4L8 18 4 14h6v6h6v-6h6l-4 4 1.4 1.4 5.4-5.4-5.4-5.4L20 10h-6V4h6l-4 4 1.4 1.4 5.4-5.4L17.4 2 16 3.4 20 7.4V2z</Geometry>
        <Geometry x:Key="IconRotate">M12 4V1L8 5l4 4V6c3.31 0 6 2.69 6 6 0 1.01-.25 1.97-.7 2.8l1.46 1.46C19.54 15.03 20 13.57 20 12c0-4.42-3.58-8-8-8zm0 14c-3.31 0-6-2.69-6-6 0-1.01.25-1.97.7-2.8L5.24 7.74C4.46 8.97 4 10.43 4 12c0 4.42 3.58 8 8 8v3l4-4-4-4v3z</Geometry>
        <Geometry x:Key="IconScale">M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V5h14v14zM7 10h2v7H7zm4-3h2v10h-2zm4 6h2v4h-2z</Geometry>
        <Geometry x:Key="IconBounds2D">M3 3h6v2H5v4H3V3zm12 0h6v6h-2V5h-4V3zM3 15h2v4h4v2H3v-6zm16 4h-4v2h6v-6h-2v4z</Geometry>
        <Geometry x:Key="IconSnap">M13 2.05v3.03c3.39.49 6 3.39 6 6.92 0 .9-.18 1.75-.48 2.54l2.6 1.53c.56-1.24.88-2.62.88-4.07 0-5.18-3.95-9.45-9-9.95zM12 19c-3.87 0-7-3.13-7-7 0-3.53 2.61-6.43 6-6.92V2.05c-5.05.5-9 4.77-9 9.95 0 5.52 4.47 10 9.99 10 3.31 0 6.24-1.61 8.01-4.09l-2.45-1.45C16.32 17.8 14.32 19 12 19z</Geometry>
        <Geometry x:Key="IconGrid">M20 2H4c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zM8 20H4v-4h4v4zm0-6H4v-4h4v4zm0-6H4V4h4v4zm6 12h-4v-4h4v4zm0-6h-4v-4h4v4zm0-6h-4V4h4v4zm6 12h-4v-4h4v4zm0-6h-4v-4h4v4zm0-6h-4V4h4v4z</Geometry>
        <Geometry x:Key="IconBuild">M22.7 19l-9.1-9.1c.9-2.3.4-5-1.5-6.9-2-2-5-2.4-7.4-1.3L9 6 6 9 1.6 4.7C.4 7.1.9 10.1 2.9 12.1c1.9 1.9 4.6 2.4 6.9 1.5l9.1 9.1c.4.4 1 .4 1.4 0l2.3-2.3c.5-.4.5-1.1.1-1.4z</Geometry>
        <Geometry x:Key="IconScene">M18 4l2 4h-3l-2-4h-2l2 4h-3l-2-4H8l2 4H7L5 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V4h-4z</Geometry>
        <Geometry x:Key="IconMoreVertical">M12 8c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm0 2c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm0 6c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z</Geometry>
        <Geometry x:Key="IconMoreHorizontal">M6 10c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm12 0c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm-6 0c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z</Geometry>
        <Thickness x:Key="ToolTipPadding">4,2,4,2</Thickness>
    </Styles.Resources>

    <!-- ========================================================================= -->
    <!-- Base Typography                                                           -->
    <!-- ========================================================================= -->
    <Style Selector=":is(TopLevel)">
        <Setter Property="FontFamily" Value="avares://Avalonia.Fonts.Inter/Assets#Inter" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style Selector="Window">
        <Setter Property="FontFamily" Value="avares://Avalonia.Fonts.Inter/Assets#Inter" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style Selector="TextBlock">
        <Setter Property="FontFamily" Value="avares://Avalonia.Fonts.Inter/Assets#Inter" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style Selector="ContentControl">
        <Setter Property="FontFamily" Value="avares://Avalonia.Fonts.Inter/Assets#Inter" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- ========================================================================= -->
    <!-- Buttons (Button, ToggleButton, RepeatButton)                              -->
    <!-- ========================================================================= -->
    <Style Selector="Button">
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="Padding" Value="8,4,8,4" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="ToggleButton">
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="Padding" Value="8,4,8,4" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="ToggleButton:checked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource IgniteAccentBrush}" />
        <Setter Property="Foreground" Value="#121417" />
        <Setter Property="BorderBrush" Value="{DynamicResource IgniteAccentBrush}" />
    </Style>
    <Style Selector="ToggleButton:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource IgniteAccentHoverBrush}" />
        <Setter Property="Foreground" Value="#121417" />
        <Setter Property="BorderBrush" Value="{DynamicResource IgniteAccentHoverBrush}" />
    </Style>
    <Style Selector="ToggleButton:checked:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource IgniteAccentPressedBrush}" />
        <Setter Property="Foreground" Value="#121417" />
        <Setter Property="BorderBrush" Value="{DynamicResource IgniteAccentPressedBrush}" />
    </Style>
    <Style Selector="ToggleButton:checked TextBlock">
        <Setter Property="Foreground" Value="#121417" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="ToggleButton:checked PathIcon">
        <Setter Property="Foreground" Value="#121417" />
    </Style>
    <Style Selector="ToggleButton:checked:pointerover TextBlock">
        <Setter Property="Foreground" Value="#121417" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="ToggleButton:checked:pointerover PathIcon">
        <Setter Property="Foreground" Value="#121417" />
    </Style>
    <Style Selector="ToggleButton:checked:pressed TextBlock">
        <Setter Property="Foreground" Value="#121417" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="ToggleButton:checked:pressed PathIcon">
        <Setter Property="Foreground" Value="#121417" />
    </Style>

    <Style Selector="RepeatButton">
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="Padding" Value="8,4,8,4" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <!-- ========================================================================= -->
    <!-- Text Input (TextBox, NumericUpDown)                                       -->
    <!-- ========================================================================= -->
    <Style Selector="TextBox">
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="Padding" Value="4,2,4,2" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="NumericUpDown">
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="Padding" Value="4,2,4,2" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- ========================================================================= -->
    <!-- TreeView & TreeViewItem Density Overrides                                 -->
    <!-- ========================================================================= -->
    <Style Selector="TreeView">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
    </Style>

    <Style Selector="TreeViewItem">
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TreeViewItem /template/ Border#PART_LayoutRoot">
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
    </Style>

    <Style Selector="TreeViewItem /template/ Panel#PART_Header">
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TreeViewItem /template/ ToggleButton#PART_ExpandCollapseChevron">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
        <Setter Property="MinHeight" Value="8" />
        <Setter Property="MinWidth" Value="8" />
        <Setter Property="Margin" Value="2,0,0,0" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- ========================================================================= -->
    <!-- ListBox & ListBoxItem                                                     -->
    <!-- ========================================================================= -->
    <Style Selector="ListBox">
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style Selector="ListBoxItem">
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="Padding" Value="4,1,4,1" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- ========================================================================= -->
    <!-- TabControl & TabItem                                                      -->
    <!-- ========================================================================= -->
    <Style Selector="TabControl">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
    </Style>

    <Style Selector="TabItem">
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Padding" Value="10,4,10,4" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource IgniteTextSecondaryBrush}" />
        <Setter Property="CornerRadius" Value="4,4,0,0" />
        <Setter Property="BorderThickness" Value="0,0,0,2" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style Selector="TabItem:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource IgniteTextPrimaryBrush}" />
    </Style>

    <Style Selector="TabItem:selected">
        <Setter Property="Foreground" Value="{DynamicResource IgniteAccentBrush}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="BorderBrush" Value="{DynamicResource IgniteActiveTabIndicatorBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,2" />
    </Style>

    <!-- Disable the inner text-foot underline pipe from Fluent template -->
    <Style Selector="TabItem /template/ Border#PART_SelectedPipe">
        <Setter Property="IsVisible" Value="False" />
        <Setter Property="Height" Value="0" />
    </Style>
    <Style Selector="TabItem:selected /template/ Border#PART_SelectedPipe">
        <Setter Property="IsVisible" Value="False" />
        <Setter Property="Height" Value="0" />
    </Style>


    <!-- ========================================================================= -->
    <!-- ScrollBar                                                                 -->
    <!-- ========================================================================= -->
    <Style Selector="ScrollBar">
        <Setter Property="AllowAutoHide" Value="False" />
    </Style>

    <Style Selector="ScrollBar:vertical">
        <Setter Property="Width" Value="8" />
        <Setter Property="MinWidth" Value="8" />
    </Style>

    <Style Selector="ScrollBar:horizontal">
        <Setter Property="Height" Value="8" />
        <Setter Property="MinHeight" Value="8" />
    </Style>

    <!-- ========================================================================= -->
    <!-- Menu & MenuItem Density                                                   -->
    <!-- ========================================================================= -->
    <Style Selector="Menu">
        <Setter Property="Height" Value="24" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Menu > MenuItem">
        <Setter Property="Height" Value="24" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Padding" Value="8,2,8,2" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="CornerRadius" Value="2" />
    </Style>

    <Style Selector="MenuItem">
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="Padding" Value="8,2,8,2" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ========================================================================= -->
    <!-- ComboBox & ComboBoxItem                                                   -->
    <!-- ========================================================================= -->
    <Style Selector="ComboBox">
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="Padding" Value="4,2,4,2" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="ComboBoxItem">
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="Padding" Value="4,2,4,2" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- ========================================================================= -->
    <!-- ToolTip                                                                   -->
    <!-- ========================================================================= -->
    <Style Selector="ToolTip">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Padding" Value="4,2,4,2" />
    </Style>

    <!-- ========================================================================= -->
    <!-- GridSplitter                                                              -->
    <!-- ========================================================================= -->
    <Style Selector="GridSplitter">
        <Setter Property="Focusable" Value="True" />
        <Setter Property="MinWidth" Value="4" />
        <Setter Property="MinHeight" Value="4" />
        <Setter Property="Background" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
    </Style>

    <Style Selector="GridSplitter:vertical">
        <Setter Property="Width" Value="4" />
    </Style>

    <Style Selector="GridSplitter:horizontal">
        <Setter Property="Height" Value="4" />
    </Style>

    <!-- ========================================================================= -->
    <!-- Additional Compact Controls (CheckBox, RadioButton, Slider, Separator)    -->
    <!-- ========================================================================= -->
    <Style Selector="CheckBox">
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="Padding" Value="4,2,4,2" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="RadioButton">
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="Padding" Value="4,2,4,2" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Slider">
        <Setter Property="MinHeight" Value="20" />
    </Style>

    <Style Selector="ProgressBar">
        <Setter Property="MinHeight" Value="4" />
    </Style>

    <Style Selector="Separator">
        <Setter Property="Margin" Value="0,2,0,2" />
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
    </Style>

    <!-- ========================================================================= -->
    <!-- Expander Density & Full-Width Stretch Overrides                           -->
    <!-- ========================================================================= -->
    <!-- Expander Density & Styling (Compact, Clean, No Accent Color When Opened) -->
    <!-- ========================================================================= -->
    <Style Selector="Expander">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Background" Value="#18191B" />
        <Setter Property="BorderBrush" Value="#2C2E33" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="3" />
    </Style>

    <!-- Header Base (Normal Closed State) -->
    <Style Selector="Expander /template/ ToggleButton#ExpanderHeader">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Padding" Value="4,1" />
        <Setter Property="Background" Value="#202124" />
        <Setter Property="BorderBrush" Value="#2C2E33" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Foreground" Value="#F0F2F5" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <Style Selector="Expander /template/ ToggleButton#ExpanderHeader /template/ Border#ToggleButtonBackground">
        <Setter Property="Background" Value="#202124" />
        <Setter Property="BorderBrush" Value="#2C2E33" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="3" />
    </Style>

    <Style Selector="Expander /template/ ToggleButton#ExpanderHeader /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="#F0F2F5" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- Header PointerOver -->
    <Style Selector="Expander /template/ ToggleButton#ExpanderHeader:pointerover">
        <Setter Property="Background" Value="#282A2E" />
        <Setter Property="BorderBrush" Value="#383A40" />
        <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Expander /template/ ToggleButton#ExpanderHeader:pointerover /template/ Border#ToggleButtonBackground">
        <Setter Property="Background" Value="#282A2E" />
        <Setter Property="BorderBrush" Value="#383A40" />
    </Style>
    <Style Selector="Expander /template/ ToggleButton#ExpanderHeader:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>

    <!-- REMOVE ACCENT COLOR WHEN OPENED: Checked State -->
    <Style Selector="Expander /template/ ToggleButton#ExpanderHeader:checked">
        <Setter Property="Background" Value="#202124" />
        <Setter Property="BorderBrush" Value="#2C2E33" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="#F0F2F5" />
        <Setter Property="CornerRadius" Value="3,3,0,0" />
    </Style>
    <Style Selector="Expander /template/ ToggleButton#ExpanderHeader:checked /template/ Border#ToggleButtonBackground">
        <Setter Property="Background" Value="#202124" />
        <Setter Property="BorderBrush" Value="#2C2E33" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="3,3,0,0" />
    </Style>
    <Style Selector="Expander /template/ ToggleButton#ExpanderHeader:checked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="#F0F2F5" />
    </Style>

    <!-- Checked + PointerOver (Opened + Hover) - NO ACCENT COLOR -->
    <Style Selector="Expander /template/ ToggleButton#ExpanderHeader:checked:pointerover">
        <Setter Property="Background" Value="#282A2E" />
        <Setter Property="BorderBrush" Value="#383A40" />
        <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Expander /template/ ToggleButton#ExpanderHeader:checked:pointerover /template/ Border#ToggleButtonBackground">
        <Setter Property="Background" Value="#282A2E" />
        <Setter Property="BorderBrush" Value="#383A40" />
    </Style>
    <Style Selector="Expander /template/ ToggleButton#ExpanderHeader:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>

    <!-- Checked + Pressed (Opened + Pressed) - NO ACCENT COLOR -->
    <Style Selector="Expander /template/ ToggleButton#ExpanderHeader:checked:pressed">
        <Setter Property="Background" Value="#1A1B1D" />
        <Setter Property="BorderBrush" Value="#2C2E33" />
        <Setter Property="Foreground" Value="#F0F2F5" />
    </Style>
    <Style Selector="Expander /template/ ToggleButton#ExpanderHeader:checked:pressed /template/ Border#ToggleButtonBackground">
        <Setter Property="Background" Value="#1A1B1D" />
        <Setter Property="BorderBrush" Value="#2C2E33" />
    </Style>
    <Style Selector="Expander /template/ ToggleButton#ExpanderHeader:checked:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="#F0F2F5" />
    </Style>

    <!-- Expander:expanded pseudo-class (Also ensure NO ACCENT COLOR) -->
    <Style Selector="Expander:expanded /template/ ToggleButton#ExpanderHeader">
        <Setter Property="Background" Value="#202124" />
        <Setter Property="BorderBrush" Value="#2C2E33" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="#F0F2F5" />
        <Setter Property="CornerRadius" Value="3,3,0,0" />
    </Style>
    <Style Selector="Expander:expanded /template/ ToggleButton#ExpanderHeader /template/ Border#ToggleButtonBackground">
        <Setter Property="Background" Value="#202124" />
        <Setter Property="BorderBrush" Value="#2C2E33" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="3,3,0,0" />
    </Style>
    <Style Selector="Expander:expanded /template/ ToggleButton#ExpanderHeader /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="#F0F2F5" />
    </Style>

    <!-- Expander Content Border -->
    <Style Selector="Expander /template/ Border#ExpanderContent">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="#18191B" />
        <Setter Property="BorderBrush" Value="#2C2E33" />
        <Setter Property="BorderThickness" Value="1,0,1,1" />
        <Setter Property="CornerRadius" Value="0,0,3,3" />
    </Style>

    <!-- Compact Chevron Dimensions & Visibility -->
    <Style Selector="Expander /template/ ToggleButton#ExpanderHeader /template/ Border#ExpandCollapseChevronBorder">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
        <Setter Property="MinHeight" Value="14" />
        <Setter Property="MinWidth" Value="14" />
        <Setter Property="Margin" Value="2,0,4,0" />
        <Setter Property="Opacity" Value="0.6" />
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.1" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Expander:pointerover /template/ ToggleButton#ExpanderHeader /template/ Border#ExpandCollapseChevronBorder">
        <Setter Property="Opacity" Value="1.0" />
    </Style>
    <Style Selector="Expander:expanded /template/ ToggleButton#ExpanderHeader /template/ Border#ExpandCollapseChevronBorder">
        <Setter Property="Opacity" Value="0.8" />
    </Style>

    <Style Selector="Expander /template/ ToggleButton#ExpanderHeader /template/ Path#ExpandCollapseChevron">
        <Setter Property="Width" Value="7" />
        <Setter Property="Height" Value="7" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Opacity" Value="0.6" />
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.1" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Expander:pointerover /template/ ToggleButton#ExpanderHeader /template/ Path#ExpandCollapseChevron">
        <Setter Property="Opacity" Value="1.0" />
    </Style>
    <Style Selector="Expander:expanded /template/ ToggleButton#ExpanderHeader /template/ Path#ExpandCollapseChevron">
        <Setter Property="Opacity" Value="0.85" />
    </Style>

    <!-- ========================================================================= -->
    <!-- Component Options Button (.comp-more-btn)                                 -->
    <!-- ========================================================================= -->
    <Style Selector="Button.comp-more-btn">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="MinHeight" Value="18" />
        <Setter Property="MinWidth" Value="18" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Foreground" Value="#888888" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.comp-more-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#2A2D32" />
    </Style>
    <Style Selector="Button.comp-more-btn:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource IgniteAccentBrush}" />
    </Style>
    <Style Selector="Button.comp-more-btn:pointerover PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource IgniteAccentBrush}" />
    </Style>
    <Style Selector="Button.comp-more-btn:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#383A40" />
    </Style>

    <!-- ========================================================================= -->
    <!-- Reset Button (.reset-btn)                                                 -->
    <!-- ========================================================================= -->
    <Style Selector="Button.reset-btn">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="MinHeight" Value="16" />
        <Setter Property="MinWidth" Value="16" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Foreground" Value="#707070" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.reset-btn:pointerover">
        <Setter Property="Background" Value="#333333" />
        <Setter Property="Foreground" Value="#E0E0E0" />
    </Style>
    <Style Selector="Button.reset-btn:pressed">
        <Setter Property="Background" Value="#444444" />
        <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>

    <!-- ========================================================================= -->
    <!-- Window Chrome Overrides                                                   -->
    <!-- ========================================================================= -->
    <!-- Hide Avalonia's built-in Title text in custom title bars -->
    <Style Selector="TextBlock#PART_Title">
        <Setter Property="IsVisible" Value="False" />
        <Setter Property="Width" Value="0" />
        <Setter Property="Height" Value="0" />
        <Setter Property="Opacity" Value="0" />
    </Style>

    <!-- Hide Avalonia's built-in FullScreen button -->
    <Style Selector="Button#PART_FullScreenButton">
        <Setter Property="IsVisible" Value="False" />
        <Setter Property="Width" Value="0" />
        <Setter Property="Height" Value="0" />
        <Setter Property="Opacity" Value="0" />
        <Setter Property="IsEnabled" Value="False" />
    </Style>
    <Style Selector="Button[(chrome|WindowDecorationProperties.ElementRole)=FullScreenButton]">
        <Setter Property="IsVisible" Value="False" />
        <Setter Property="Width" Value="0" />
        <Setter Property="Height" Value="0" />
        <Setter Property="Opacity" Value="0" />
        <Setter Property="IsEnabled" Value="False" />
    </Style>

</Styles>
