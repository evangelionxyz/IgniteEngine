<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chrome="using:Avalonia.Controls.Chrome">

    <!-- ========================================================================= -->
    <!-- IgniteEditor Compact Styling Overrides                                    -->
    <!-- Global density rules for game engine editor layout:                       -->
    <!--   - 12px Base Font (Inter)                                                -->
    <!--   - 2-4px Compact Padding                                                 -->
    <!--   - Tight Control MinHeights (20-24px)                                    -->
    <!--   - 8px Slim ScrollBars                                                   -->
    <!--   - 4px GridSplitters                                                     -->
    <!-- ========================================================================= -->

    <Styles.Resources>
        <!-- Font Family & Typography Tokens -->
        <FontFamily x:Key="ContentControlThemeFontFamily">avares://Avalonia.Fonts.Inter/Assets#Inter</FontFamily>
        <x:Double x:Key="ControlContentThemeFontSize">12</x:Double>

        <!-- Button Density Tokens -->
        <Thickness x:Key="ButtonPadding">8,4,8,4</Thickness>
        <x:Double x:Key="ButtonMinHeight">22</x:Double>

        <!-- TextBox & Input Density Tokens -->
        <Thickness x:Key="TextControlThemePadding">4,2,4,2</Thickness>
        <x:Double x:Key="TextControlThemeMinHeight">22</x:Double>

        <!-- TreeView Density Tokens -->
        <x:Double x:Key="TreeViewItemIndent">16</x:Double>
        <x:Double x:Key="TreeViewItemIndentSize">16</x:Double>
        <x:Double x:Key="TreeViewItemMinHeight">22</x:Double>

        <!-- ListBox Density Tokens -->
        <Thickness x:Key="ListBoxItemPadding">4,2,4,2</Thickness>
        <x:Double x:Key="ListBoxItemMinHeight">20</x:Double>

        <!-- Tab Density Tokens -->
        <Thickness x:Key="TabItemHeaderThemePadding">8,4,8,4</Thickness>
        <x:Double x:Key="TabItemMinHeight">24</x:Double>
        <x:Double x:Key="TabItemThemeFontSize">11</x:Double>

        <!-- Expander Density Tokens -->
        <x:Double x:Key="ExpanderMinHeight">24</x:Double>
        <Thickness x:Key="ExpanderHeaderPadding">4,2,4,2</Thickness>

        <!-- ScrollBar Density Tokens -->
        <x:Double x:Key="ScrollBarSize">8</x:Double>
        <x:Double x:Key="ScrollBarThickness">8</x:Double>

        <!-- Menu Density Tokens -->
        <Thickness x:Key="MenuFlyoutItemThemePadding">6,2,6,2</Thickness>
        <Thickness x:Key="MenuItemPadding">6,2,6,2</Thickness>
        <x:Double x:Key="MenuItemMinHeight">22</x:Double>
        <x:Double x:Key="MenuBarHeight">22</x:Double>

        <!-- ComboBox Density Tokens -->
        <Thickness x:Key="ComboBoxPadding">4,2,4,2</Thickness>
        <x:Double x:Key="ComboBoxMinHeight">22</x:Double>

        <!-- ToolTip Density Tokens -->
        <x:Double x:Key="ToolTipContentThemeFontSize">11</x:Double>
        <Thickness x:Key="ToolTipPadding">4,2,4,2</Thickness>
    </Styles.Resources>

    <!-- ========================================================================= -->
    <!-- Base Typography                                                           -->
    <!-- ========================================================================= -->
    <Style Selector=":is(TopLevel)">
        <Setter Property="FontFamily" Value="avares://Avalonia.Fonts.Inter/Assets#Inter" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style Selector="Window">
        <Setter Property="FontFamily" Value="avares://Avalonia.Fonts.Inter/Assets#Inter" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style Selector="TextBlock">
        <Setter Property="FontFamily" Value="avares://Avalonia.Fonts.Inter/Assets#Inter" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style Selector="ContentControl">
        <Setter Property="FontFamily" Value="avares://Avalonia.Fonts.Inter/Assets#Inter" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- ========================================================================= -->
    <!-- Buttons (Button, ToggleButton, RepeatButton)                              -->
    <!-- ========================================================================= -->
    <Style Selector="Button">
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="Padding" Value="8,4,8,4" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="ToggleButton">
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="Padding" Value="8,4,8,4" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="RepeatButton">
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="Padding" Value="8,4,8,4" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <!-- ========================================================================= -->
    <!-- Text Input (TextBox, NumericUpDown)                                       -->
    <!-- ========================================================================= -->
    <Style Selector="TextBox">
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="Padding" Value="4,2,4,2" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="NumericUpDown">
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="Padding" Value="4,2,4,2" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- ========================================================================= -->
    <!-- TreeView & TreeViewItem Density Overrides                                 -->
    <!-- ========================================================================= -->
    <Style Selector="TreeView">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
    </Style>

    <Style Selector="TreeViewItem">
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TreeViewItem /template/ Border#PART_LayoutRoot">
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
    </Style>

    <Style Selector="TreeViewItem /template/ Panel#PART_Header">
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TreeViewItem /template/ ToggleButton#PART_ExpandCollapseChevron">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
        <Setter Property="MinHeight" Value="8" />
        <Setter Property="MinWidth" Value="8" />
        <Setter Property="Margin" Value="2,0,0,0" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- ========================================================================= -->
    <!-- ListBox & ListBoxItem                                                     -->
    <!-- ========================================================================= -->
    <Style Selector="ListBox">
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style Selector="ListBoxItem">
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="Padding" Value="4,1,4,1" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- ========================================================================= -->
    <!-- TabControl & TabItem                                                      -->
    <!-- ========================================================================= -->
    <Style Selector="TabControl">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
    </Style>

    <Style Selector="TabItem">
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Padding" Value="8,4,8,4" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- ========================================================================= -->
    <!-- Expander                                                                  -->
    <!-- ========================================================================= -->
    <Style Selector="Expander">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style Selector="Expander /template/ ToggleButton#ExpanderHeader">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <Style Selector="Expander /template/ ToggleButton">
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Padding" Value="4,2,4,2" />
    </Style>

    <!-- ========================================================================= -->
    <!-- ScrollBar                                                                 -->
    <!-- ========================================================================= -->
    <Style Selector="ScrollBar">
        <Setter Property="AllowAutoHide" Value="False" />
    </Style>

    <Style Selector="ScrollBar:vertical">
        <Setter Property="Width" Value="8" />
        <Setter Property="MinWidth" Value="8" />
    </Style>

    <Style Selector="ScrollBar:horizontal">
        <Setter Property="Height" Value="8" />
        <Setter Property="MinHeight" Value="8" />
    </Style>

    <!-- ========================================================================= -->
    <!-- Menu & MenuItem Density                                                   -->
    <!-- ========================================================================= -->
    <Style Selector="Menu">
        <Setter Property="Height" Value="24" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Menu > MenuItem">
        <Setter Property="Height" Value="24" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Padding" Value="8,2,8,2" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="CornerRadius" Value="2" />
    </Style>

    <Style Selector="MenuItem">
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="Padding" Value="8,2,8,2" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ========================================================================= -->
    <!-- ComboBox & ComboBoxItem                                                   -->
    <!-- ========================================================================= -->
    <Style Selector="ComboBox">
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="Padding" Value="4,2,4,2" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="ComboBoxItem">
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="Padding" Value="4,2,4,2" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- ========================================================================= -->
    <!-- ToolTip                                                                   -->
    <!-- ========================================================================= -->
    <Style Selector="ToolTip">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Padding" Value="4,2,4,2" />
    </Style>

    <!-- ========================================================================= -->
    <!-- GridSplitter                                                              -->
    <!-- ========================================================================= -->
    <Style Selector="GridSplitter">
        <Setter Property="Focusable" Value="True" />
        <Setter Property="MinWidth" Value="4" />
        <Setter Property="MinHeight" Value="4" />
        <Setter Property="Background" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
    </Style>

    <Style Selector="GridSplitter:vertical">
        <Setter Property="Width" Value="4" />
    </Style>

    <Style Selector="GridSplitter:horizontal">
        <Setter Property="Height" Value="4" />
    </Style>

    <!-- ========================================================================= -->
    <!-- Additional Compact Controls (CheckBox, RadioButton, Slider, Separator)    -->
    <!-- ========================================================================= -->
    <Style Selector="CheckBox">
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="Padding" Value="4,2,4,2" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="RadioButton">
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="Padding" Value="4,2,4,2" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Slider">
        <Setter Property="MinHeight" Value="20" />
    </Style>

    <Style Selector="ProgressBar">
        <Setter Property="MinHeight" Value="4" />
    </Style>

    <Style Selector="Separator">
        <Setter Property="Margin" Value="0,2,0,2" />
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
    </Style>

    <!-- ========================================================================= -->
    <!-- Expander Density & Full-Width Stretch Overrides                           -->
    <!-- ========================================================================= -->
    <Style Selector="Expander">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="MinWidth" Value="0" />
    </Style>

    <Style Selector="Expander /template/ ToggleButton#ExpanderHeader">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Padding" Value="2,1" />
		<Setter Property="Background" Value="#121212" />
    </Style>

    <Style Selector="Expander /template/ Border#ExpanderContent">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0" />
		<Setter Property="Background" Value="#121212" />
    </Style>

    <Style Selector="Expander /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>

    <!-- ========================================================================= -->
    <!-- Reset Button (.reset-btn)                                                 -->
    <!-- ========================================================================= -->
    <Style Selector="Button.reset-btn">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="MinHeight" Value="16" />
        <Setter Property="MinWidth" Value="16" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Foreground" Value="#707070" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.reset-btn:pointerover">
        <Setter Property="Background" Value="#333333" />
        <Setter Property="Foreground" Value="#E0E0E0" />
    </Style>
    <Style Selector="Button.reset-btn:pressed">
        <Setter Property="Background" Value="#444444" />
        <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>

    <!-- ========================================================================= -->
    <!-- Window Chrome Overrides                                                   -->
    <!-- ========================================================================= -->
    <!-- Hide Avalonia's built-in Title text in custom title bars -->
    <Style Selector="TextBlock#PART_Title">
        <Setter Property="IsVisible" Value="False" />
        <Setter Property="Width" Value="0" />
        <Setter Property="Height" Value="0" />
        <Setter Property="Opacity" Value="0" />
    </Style>

    <!-- Hide Avalonia's built-in FullScreen button -->
    <Style Selector="Button#PART_FullScreenButton">
        <Setter Property="IsVisible" Value="False" />
        <Setter Property="Width" Value="0" />
        <Setter Property="Height" Value="0" />
        <Setter Property="Opacity" Value="0" />
        <Setter Property="IsEnabled" Value="False" />
    </Style>
    <Style Selector="Button[(chrome|WindowDecorationProperties.ElementRole)=FullScreenButton]">
        <Setter Property="IsVisible" Value="False" />
        <Setter Property="Width" Value="0" />
        <Setter Property="Height" Value="0" />
        <Setter Property="Opacity" Value="0" />
        <Setter Property="IsEnabled" Value="False" />
    </Style>

</Styles>
