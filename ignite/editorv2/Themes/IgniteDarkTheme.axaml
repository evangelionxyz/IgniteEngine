<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========================================================================= -->
    <!-- IgniteEditor Modern High-Contrast IDE Dark Theme                          -->
    <!-- Modern Slate/Charcoal Palette with Electric Lime (#D1FE17) Accents        -->
    <!--   Window Base:        #18191B                                             -->
    <!--   Sidebar / Deep:     #141517                                             -->
    <!--   Panel Surfaces:     #232528                                             -->
    <!--   Card / Container:   #202124                                             -->
    <!--   Control Fill:       #2B2D31                                             -->
    <!--   Hover State:        #35383E                                             -->
    <!--   Active / Selected:  #253310 / #2B380E                                   -->
    <!--   Borders / Dividers: #383A40 / #2C2E33                                   -->
    <!--   Accent Lime:        #D1FE17                                             -->
    <!--   Text Primary:       #F0F2F5                                             -->
    <!--   Text Secondary:     #A0A4B0                                             -->
    <!--   Text Muted:         #707582                                             -->
    <!-- ========================================================================= -->

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <!-- Electric Lime Accent Tokens -->
            <Color x:Key="SystemAccentColor">#D1FE17</Color>
            <Color x:Key="SystemAccentColorDark1">#B8E312</Color>
            <Color x:Key="SystemAccentColorDark2">#9BC20E</Color>
            <Color x:Key="SystemAccentColorDark3">#7F9F09</Color>
            <Color x:Key="SystemAccentColorLight1">#DBFE40</Color>
            <Color x:Key="SystemAccentColorLight2">#E4FE6E</Color>
            <Color x:Key="SystemAccentColorLight3">#EEFEA4</Color>

            <!-- Accent Brushes -->
            <SolidColorBrush x:Key="SystemAccentColorBrush" Color="#D1FE17" />
            <SolidColorBrush x:Key="SystemAccentColorDark1Brush" Color="#B8E312" />
            <SolidColorBrush x:Key="SystemAccentColorDark2Brush" Color="#9BC20E" />
            <SolidColorBrush x:Key="SystemAccentColorDark3Brush" Color="#7F9F09" />
            <SolidColorBrush x:Key="SystemAccentColorLight1Brush" Color="#DBFE40" />
            <SolidColorBrush x:Key="SystemAccentColorLight2Brush" Color="#E4FE6E" />
            <SolidColorBrush x:Key="SystemAccentColorLight3Brush" Color="#EEFEA4" />
            <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#D1FE17" />

            <!-- System Region / Window Background -->
            <Color x:Key="SystemRegionColor">#18191B</Color>
            <SolidColorBrush x:Key="SystemRegionBrush" Color="#18191B" />

            <!-- Solid Background Tokens -->
            <Color x:Key="SolidBackgroundFillColorBase">#18191B</Color>
            <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#18191B" />
            <Color x:Key="SolidBackgroundFillColorSecondary">#232528</Color>
            <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="#232528" />
            <Color x:Key="SolidBackgroundFillColorTertiary">#202124</Color>
            <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="#202124" />
            <Color x:Key="SolidBackgroundFillColorQuarternary">#35383E</Color>
            <SolidColorBrush x:Key="SolidBackgroundFillColorQuarternaryBrush" Color="#35383E" />
            <Color x:Key="SolidBackgroundFillColorTransparent">#00000000</Color>
            <SolidColorBrush x:Key="SolidBackgroundFillColorTransparentBrush" Color="Transparent" />

            <!-- Card / Panel Background Tokens -->
            <Color x:Key="CardBackgroundFillColorDefault">#232528</Color>
            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#232528" />
            <Color x:Key="CardBackgroundFillColorSecondary">#18191B</Color>
            <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#18191B" />
            <Color x:Key="CardBackgroundFillColorTertiary">#202124</Color>
            <SolidColorBrush x:Key="CardBackgroundFillColorTertiaryBrush" Color="#202124" />

            <!-- Control Fill Tokens (Buttons, TextBoxes, Inputs) -->
            <Color x:Key="ControlFillColorDefault">#2B2D31</Color>
            <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#2B2D31" />
            <Color x:Key="ControlFillColorSecondary">#35383E</Color>
            <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#35383E" />
            <Color x:Key="ControlFillColorTertiary">#202124</Color>
            <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#202124" />
            <Color x:Key="ControlFillColorDisabled">#8018191B</Color>
            <SolidColorBrush x:Key="ControlFillColorDisabledBrush" Color="#8018191B" />
            <Color x:Key="ControlFillColorTransparent">#00000000</Color>
            <SolidColorBrush x:Key="ControlFillColorTransparentBrush" Color="Transparent" />
            <Color x:Key="ControlFillColorInputActive">#1E2023</Color>
            <SolidColorBrush x:Key="ControlFillColorInputActiveBrush" Color="#1E2023" />

            <!-- Control & Card Stroke / Border Tokens -->
            <Color x:Key="ControlStrokeColorDefault">#383A40</Color>
            <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#383A40" />
            <Color x:Key="ControlStrokeColorSecondary">#484B53</Color>
            <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#484B53" />
            <Color x:Key="ControlStrokeColorOnAccentDefault">#121417</Color>
            <SolidColorBrush x:Key="ControlStrokeColorOnAccentDefaultBrush" Color="#121417" />
            <Color x:Key="CardStrokeColorDefault">#383A40</Color>
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#383A40" />
            <Color x:Key="CardStrokeColorDefaultSolid">#383A40</Color>
            <SolidColorBrush x:Key="CardStrokeColorDefaultSolidBrush" Color="#383A40" />
            <Color x:Key="DividerStrokeColorDefault">#2C2E33</Color>
            <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#2C2E33" />
            <Color x:Key="SurfaceStrokeColorDefault">#383A40</Color>
            <SolidColorBrush x:Key="SurfaceStrokeColorDefaultBrush" Color="#383A40" />
            <SolidColorBrush x:Key="ControlElevationBorderBrush" Color="#383A40" />

            <!-- Text & Foreground Tokens -->
            <Color x:Key="TextFillColorPrimary">#F0F2F5</Color>
            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#F0F2F5" />
            <Color x:Key="TextFillColorSecondary">#A0A4B0</Color>
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#A0A4B0" />
            <Color x:Key="TextFillColorTertiary">#707582</Color>
            <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#707582" />
            <Color x:Key="TextFillColorDisabled">#555861</Color>
            <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#555861" />
            <Color x:Key="TextFillColorInverse">#121417</Color>
            <SolidColorBrush x:Key="TextFillColorInverseBrush" Color="#121417" />

            <!-- Accent Fill Tokens -->
            <Color x:Key="AccentFillColorDefault">#D1FE17</Color>
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#D1FE17" />
            <Color x:Key="AccentFillColorSecondary">#DBFE40</Color>
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#DBFE40" />
            <Color x:Key="AccentFillColorTertiary">#B8E312</Color>
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#B8E312" />
            <Color x:Key="AccentFillColorDisabled">#80D1FE17</Color>
            <SolidColorBrush x:Key="AccentFillColorDisabledBrush" Color="#80D1FE17" />
            <Color x:Key="AccentFillColorSelectedTextBackground">#2B380E</Color>
            <SolidColorBrush x:Key="AccentFillColorSelectedTextBackgroundBrush" Color="#2B380E" />

            <!-- Subtle Fill Tokens -->
            <Color x:Key="SubtleFillColorTransparent">#00000000</Color>
            <SolidColorBrush x:Key="SubtleFillColorTransparentBrush" Color="Transparent" />
            <Color x:Key="SubtleFillColorSecondary">#2B2D31</Color>
            <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#2B2D31" />
            <Color x:Key="SubtleFillColorTertiary">#202124</Color>
            <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#202124" />
            <Color x:Key="SubtleFillColorDisabled">#00000000</Color>
            <SolidColorBrush x:Key="SubtleFillColorDisabledBrush" Color="Transparent" />

            <!-- TreeViewItem State Brushes -->
            <SolidColorBrush x:Key="TreeViewItemBackgroundSelected" Color="#253310" />
            <SolidColorBrush x:Key="TreeViewItemBackgroundSelectedPointerOver" Color="#2F4216" />
            <SolidColorBrush x:Key="TreeViewItemBackgroundSelectedDisabled" Color="#232528" />
            <SolidColorBrush x:Key="TreeViewItemBackgroundPointerOver" Color="#2B2E34" />
            <SolidColorBrush x:Key="TreeViewItemBackgroundDisabled" Color="Transparent" />
            <SolidColorBrush x:Key="TreeViewItemForegroundSelected" Color="#D1FE17" />
            <SolidColorBrush x:Key="TreeViewItemForegroundSelectedPointerOver" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TreeViewItemForegroundPointerOver" Color="#F0F2F5" />

            <!-- ToggleButton State Brushes -->
            <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#D1FE17" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#DBFE40" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#B8E312" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="#D1FE17" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="#DBFE40" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="#B8E312" />
            <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#121417" />
            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#121417" />
            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#121417" />

            <!-- TabItem State Brushes & Dimensions -->
            <SolidColorBrush x:Key="TabItemHeaderSelectedPipeFill" Color="Transparent" />
            <SolidColorBrush x:Key="TabItemPipeFill" Color="Transparent" />
            <x:Double x:Key="TabItemPipeThickness">0</x:Double>

            <!-- ListBoxItem State Brushes -->
            <SolidColorBrush x:Key="ListBoxItemBackgroundSelected" Color="#253310" />
            <SolidColorBrush x:Key="ListBoxItemBackgroundSelectedPointerOver" Color="#2F4216" />
            <SolidColorBrush x:Key="ListBoxItemBackgroundSelectedDisabled" Color="#232528" />
            <SolidColorBrush x:Key="ListBoxItemBackgroundPointerOver" Color="#2B2E34" />
            <SolidColorBrush x:Key="ListBoxItemBackgroundDisabled" Color="Transparent" />
            <SolidColorBrush x:Key="ListBoxItemForegroundSelected" Color="#D1FE17" />
            <SolidColorBrush x:Key="ListBoxItemForegroundSelectedPointerOver" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ListBoxItemForegroundPointerOver" Color="#F0F2F5" />

            <!-- ComboBoxItem State Brushes -->
            <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#253310" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="#2F4216" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="#2B2E34" />

            <!-- MenuItem State Brushes -->
            <SolidColorBrush x:Key="MenuItemItemBackgroundPointerOver" Color="#253310" />
            <SolidColorBrush x:Key="MenuItemItemBackgroundSelected" Color="#253310" />
            <SolidColorBrush x:Key="MenuItemForegroundPointerOver" Color="#D1FE17" />

            <!-- Selection & Highlight Brushes -->
            <Color x:Key="HighlightColor">#253310</Color>
            <SolidColorBrush x:Key="HighlightBrush" Color="#253310" />
            <SolidColorBrush x:Key="SystemControlHighlightListAccentLowBrush" Color="#202B0D" />
            <SolidColorBrush x:Key="SystemControlHighlightListAccentMediumBrush" Color="#2D3D12" />
            <SolidColorBrush x:Key="SystemControlHighlightListAccentHighBrush" Color="#D1FE17" />
            <SolidColorBrush x:Key="SystemControlHighlightAltBaseHighBrush" Color="#F0F2F5" />

            <!-- Status Tokens (Preserve distinct log visibility) -->
            <Color x:Key="SystemFillColorCritical">#E55757</Color>
            <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#E55757" />
            <Color x:Key="SystemFillColorCaution">#F5A623</Color>
            <SolidColorBrush x:Key="SystemFillColorCautionBrush" Color="#F5A623" />
            <Color x:Key="SystemFillColorSuccess">#57C378</Color>
            <SolidColorBrush x:Key="SystemFillColorSuccessBrush" Color="#57C378" />
            <Color x:Key="SystemFillColorAttention">#3592C4</Color>
            <SolidColorBrush x:Key="SystemFillColorAttentionBrush" Color="#3592C4" />
            <Color x:Key="SystemErrorColor">#E55757</Color>

            <!-- Legacy Fluent v1 Brushes -->
            <SolidColorBrush x:Key="SystemControlBackgroundAltHighBrush" Color="#18191B" />
            <SolidColorBrush x:Key="SystemControlBackgroundBaseLowBrush" Color="#232528" />
            <SolidColorBrush x:Key="SystemControlBackgroundBaseMediumLowBrush" Color="#2B2D31" />
            <SolidColorBrush x:Key="SystemControlForegroundBaseHighBrush" Color="#F0F2F5" />
            <SolidColorBrush x:Key="SystemControlForegroundBaseMediumBrush" Color="#A0A4B0" />
            <SolidColorBrush x:Key="SystemControlDisabledBaseLowBrush" Color="#8018191B" />
            <SolidColorBrush x:Key="SystemControlDisabledBaseMediumLowBrush" Color="#555861" />

            <!-- Dock.Avalonia Compatibility Brushes -->
            <SolidColorBrush x:Key="DockApplicationAccentBrushHigh" Color="#D1FE17" />
            <SolidColorBrush x:Key="DockThemeBackgroundBrush" Color="#18191B" />
            <SolidColorBrush x:Key="DockThemeBorderLowBrush" Color="#2C2E33" />
            <SolidColorBrush x:Key="DockThemeBorderHighBrush" Color="#383A40" />
            <SolidColorBrush x:Key="DockThemeControlBackgroundBrush" Color="#232528" />
            <SolidColorBrush x:Key="DockThemeForegroundBrush" Color="#F0F2F5" />

            <!-- Translucency & Glass Effect Brushes -->
            <SolidColorBrush x:Key="IgniteGlassBackgroundBrush" Color="#E018191B" />
            <SolidColorBrush x:Key="IgniteGlassPanelBrush" Color="#EB232528" />
            <SolidColorBrush x:Key="IgniteGlassHeaderBrush" Color="#F518191B" />
            <SolidColorBrush x:Key="IgniteSubtleHoverBrush" Color="#1FFFFFFF" />
            <SolidColorBrush x:Key="IgniteSubtleActiveBrush" Color="#2EFFFFFF" />

            <!-- Modern Bold Gradients -->
            <LinearGradientBrush x:Key="IgniteTitleBarGradient" StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#232529" Offset="0.0" />
                <GradientStop Color="#18191B" Offset="1.0" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="IgniteAccentGradient" StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#D1FE17" Offset="0.0" />
                <GradientStop Color="#A2D608" Offset="1.0" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="IgniteAccentGlowGradient" StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#4DD1FE17" Offset="0.0" />
                <GradientStop Color="#1AD1FE17" Offset="1.0" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="IgnitePanelHeaderGradient" StartPoint="0%,0%" EndPoint="100%,0%">
                <GradientStop Color="#2C2E33" Offset="0.0" />
                <GradientStop Color="#202124" Offset="1.0" />
            </LinearGradientBrush>

            <!-- Ignite Custom Semantic Colors & Brushes -->
            <Color x:Key="IgniteMainBackground">#18191B</Color>
            <SolidColorBrush x:Key="IgniteMainBackgroundBrush" Color="#18191B" />
            <Color x:Key="IgnitePanelBackground">#232528</Color>
            <SolidColorBrush x:Key="IgnitePanelBackgroundBrush" Color="#232528" />
            <Color x:Key="IgniteSidebarBackground">#141517</Color>
            <SolidColorBrush x:Key="IgniteSidebarBackgroundBrush" Color="#141517" />
            <Color x:Key="IgniteAccent">#D1FE17</Color>
            <SolidColorBrush x:Key="IgniteAccentBrush" Color="#D1FE17" />
            <SolidColorBrush x:Key="IgniteAccentHoverBrush" Color="#DBFE40" />
            <SolidColorBrush x:Key="IgniteAccentPressedBrush" Color="#B8E312" />
            <SolidColorBrush x:Key="IgniteActiveTabIndicatorBrush" Color="#D1FE17" />
            <Color x:Key="IgniteTextPrimary">#F0F2F5</Color>
            <SolidColorBrush x:Key="IgniteTextPrimaryBrush" Color="#F0F2F5" />
            <Color x:Key="IgniteTextSecondary">#A0A4B0</Color>
            <SolidColorBrush x:Key="IgniteTextSecondaryBrush" Color="#A0A4B0" />
            <Color x:Key="IgniteTextMuted">#707582</Color>
            <SolidColorBrush x:Key="IgniteTextMutedBrush" Color="#707582" />
            <Color x:Key="IgniteBorder">#383A40</Color>
            <SolidColorBrush x:Key="IgniteBorderBrush" Color="#383A40" />
            <Color x:Key="IgniteBorderSubtle">#2C2E33</Color>
            <SolidColorBrush x:Key="IgniteBorderSubtleBrush" Color="#2C2E33" />
            <Color x:Key="IgniteHover">#2B2E34</Color>
            <SolidColorBrush x:Key="IgniteHoverBrush" Color="#2B2E34" />
            <Color x:Key="IgniteSelection">#253310</Color>
            <SolidColorBrush x:Key="IgniteSelectionBrush" Color="#253310" />
            <Color x:Key="IgniteSelectionAccent">#2B380E</Color>
            <SolidColorBrush x:Key="IgniteSelectionAccentBrush" Color="#2B380E" />
            <Color x:Key="IgniteError">#E55757</Color>
            <SolidColorBrush x:Key="IgniteErrorBrush" Color="#E55757" />
            <Color x:Key="IgniteWarning">#F5A623</Color>
            <SolidColorBrush x:Key="IgniteWarningBrush" Color="#F5A623" />
            <Color x:Key="IgniteSuccess">#57C378</Color>
            <SolidColorBrush x:Key="IgniteSuccessBrush" Color="#57C378" />
            <Color x:Key="IgniteInfo">#3592C4</Color>
            <SolidColorBrush x:Key="IgniteInfoBrush" Color="#3592C4" />
        </ResourceDictionary>

        <!-- Default Variant matches Dark -->
        <ResourceDictionary x:Key="Default">
            <!-- Accent Colors -->
            <Color x:Key="SystemAccentColor">#D1FE17</Color>
            <Color x:Key="SystemAccentColorDark1">#B8E312</Color>
            <Color x:Key="SystemAccentColorDark2">#9BC20E</Color>
            <Color x:Key="SystemAccentColorDark3">#7F9F09</Color>
            <Color x:Key="SystemAccentColorLight1">#DBFE40</Color>
            <Color x:Key="SystemAccentColorLight2">#E4FE6E</Color>
            <Color x:Key="SystemAccentColorLight3">#EEFEA4</Color>

            <SolidColorBrush x:Key="SystemAccentColorBrush" Color="#D1FE17" />
            <SolidColorBrush x:Key="SystemAccentColorDark1Brush" Color="#B8E312" />
            <SolidColorBrush x:Key="SystemAccentColorDark2Brush" Color="#9BC20E" />
            <SolidColorBrush x:Key="SystemAccentColorDark3Brush" Color="#7F9F09" />
            <SolidColorBrush x:Key="SystemAccentColorLight1Brush" Color="#DBFE40" />
            <SolidColorBrush x:Key="SystemAccentColorLight2Brush" Color="#E4FE6E" />
            <SolidColorBrush x:Key="SystemAccentColorLight3Brush" Color="#EEFEA4" />
            <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#D1FE17" />

            <Color x:Key="SystemRegionColor">#18191B</Color>
            <SolidColorBrush x:Key="SystemRegionBrush" Color="#18191B" />

            <Color x:Key="SolidBackgroundFillColorBase">#18191B</Color>
            <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#18191B" />
            <Color x:Key="SolidBackgroundFillColorSecondary">#232528</Color>
            <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="#232528" />
            <Color x:Key="SolidBackgroundFillColorTertiary">#202124</Color>
            <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="#202124" />
            <Color x:Key="SolidBackgroundFillColorQuarternary">#35383E</Color>
            <SolidColorBrush x:Key="SolidBackgroundFillColorQuarternaryBrush" Color="#35383E" />
            <Color x:Key="SolidBackgroundFillColorTransparent">#00000000</Color>
            <SolidColorBrush x:Key="SolidBackgroundFillColorTransparentBrush" Color="Transparent" />

            <Color x:Key="CardBackgroundFillColorDefault">#232528</Color>
            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#232528" />
            <Color x:Key="CardBackgroundFillColorSecondary">#18191B</Color>
            <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#18191B" />
            <Color x:Key="CardBackgroundFillColorTertiary">#202124</Color>
            <SolidColorBrush x:Key="CardBackgroundFillColorTertiaryBrush" Color="#202124" />

            <Color x:Key="ControlFillColorDefault">#2B2D31</Color>
            <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#2B2D31" />
            <Color x:Key="ControlFillColorSecondary">#35383E</Color>
            <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#35383E" />
            <Color x:Key="ControlFillColorTertiary">#202124</Color>
            <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#202124" />
            <Color x:Key="ControlFillColorDisabled">#8018191B</Color>
            <SolidColorBrush x:Key="ControlFillColorDisabledBrush" Color="#8018191B" />
            <Color x:Key="ControlFillColorTransparent">#00000000</Color>
            <SolidColorBrush x:Key="ControlFillColorTransparentBrush" Color="Transparent" />
            <Color x:Key="ControlFillColorInputActive">#1E2023</Color>
            <SolidColorBrush x:Key="ControlFillColorInputActiveBrush" Color="#1E2023" />

            <Color x:Key="ControlStrokeColorDefault">#383A40</Color>
            <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#383A40" />
            <Color x:Key="ControlStrokeColorSecondary">#484B53</Color>
            <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#484B53" />
            <Color x:Key="ControlStrokeColorOnAccentDefault">#121417</Color>
            <SolidColorBrush x:Key="ControlStrokeColorOnAccentDefaultBrush" Color="#121417" />
            <Color x:Key="CardStrokeColorDefault">#383A40</Color>
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#383A40" />
            <Color x:Key="CardStrokeColorDefaultSolid">#383A40</Color>
            <SolidColorBrush x:Key="CardStrokeColorDefaultSolidBrush" Color="#383A40" />
            <Color x:Key="DividerStrokeColorDefault">#2C2E33</Color>
            <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#2C2E33" />
            <Color x:Key="SurfaceStrokeColorDefault">#383A40</Color>
            <SolidColorBrush x:Key="SurfaceStrokeColorDefaultBrush" Color="#383A40" />
            <SolidColorBrush x:Key="ControlElevationBorderBrush" Color="#383A40" />

            <Color x:Key="TextFillColorPrimary">#F0F2F5</Color>
            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#F0F2F5" />
            <Color x:Key="TextFillColorSecondary">#A0A4B0</Color>
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#A0A4B0" />
            <Color x:Key="TextFillColorTertiary">#707582</Color>
            <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#707582" />
            <Color x:Key="TextFillColorDisabled">#555861</Color>
            <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#555861" />
            <Color x:Key="TextFillColorInverse">#121417</Color>
            <SolidColorBrush x:Key="TextFillColorInverseBrush" Color="#121417" />

            <Color x:Key="AccentFillColorDefault">#D1FE17</Color>
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#D1FE17" />
            <Color x:Key="AccentFillColorSecondary">#DBFE40</Color>
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#DBFE40" />
            <Color x:Key="AccentFillColorTertiary">#B8E312</Color>
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#B8E312" />
            <Color x:Key="AccentFillColorDisabled">#80D1FE17</Color>
            <SolidColorBrush x:Key="AccentFillColorDisabledBrush" Color="#80D1FE17" />
            <Color x:Key="AccentFillColorSelectedTextBackground">#2B380E</Color>
            <SolidColorBrush x:Key="AccentFillColorSelectedTextBackgroundBrush" Color="#2B380E" />

            <Color x:Key="SubtleFillColorTransparent">#00000000</Color>
            <SolidColorBrush x:Key="SubtleFillColorTransparentBrush" Color="Transparent" />
            <Color x:Key="SubtleFillColorSecondary">#2B2D31</Color>
            <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#2B2D31" />
            <Color x:Key="SubtleFillColorTertiary">#202124</Color>
            <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#202124" />
            <Color x:Key="SubtleFillColorDisabled">#00000000</Color>
            <SolidColorBrush x:Key="SubtleFillColorDisabledBrush" Color="Transparent" />

            <SolidColorBrush x:Key="TreeViewItemBackgroundSelected" Color="#253310" />
            <SolidColorBrush x:Key="TreeViewItemBackgroundSelectedPointerOver" Color="#2F4216" />
            <SolidColorBrush x:Key="TreeViewItemBackgroundSelectedDisabled" Color="#232528" />
            <SolidColorBrush x:Key="TreeViewItemBackgroundPointerOver" Color="#2B2E34" />
            <SolidColorBrush x:Key="TreeViewItemBackgroundDisabled" Color="Transparent" />
            <SolidColorBrush x:Key="TreeViewItemForegroundSelected" Color="#D1FE17" />
            <SolidColorBrush x:Key="TreeViewItemForegroundSelectedPointerOver" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TreeViewItemForegroundPointerOver" Color="#F0F2F5" />

            <SolidColorBrush x:Key="ListBoxItemBackgroundSelected" Color="#253310" />
            <SolidColorBrush x:Key="ListBoxItemBackgroundSelectedPointerOver" Color="#2F4216" />
            <SolidColorBrush x:Key="ListBoxItemBackgroundSelectedDisabled" Color="#232528" />
            <SolidColorBrush x:Key="ListBoxItemBackgroundPointerOver" Color="#2B2E34" />
            <SolidColorBrush x:Key="ListBoxItemBackgroundDisabled" Color="Transparent" />
