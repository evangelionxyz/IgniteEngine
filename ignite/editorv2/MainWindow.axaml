<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:IgniteEditor.ViewModels"
        xmlns:panels="using:IgniteEditor.Views.Panels"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        mc:Ignorable="d" d:DesignWidth="1440" d:DesignHeight="880"
        x:Class="IgniteEditor.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title=""
        Width="1440" Height="880"
        MinWidth="960" MinHeight="540"
        Background="#161616"
        Foreground="#E0E0E0"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="26">

    <Window.Styles>
        <!-- Toolbar Button Styling -->
        <Style Selector="Button.tool-btn">
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Background" Value="#252525" />
            <Setter Property="BorderBrush" Value="#333333" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Foreground" Value="#CCCCCC" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.tool-btn:pointerover">
            <Setter Property="Background" Value="#333333" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#444444" />
        </Style>
        <Style Selector="ToggleButton.tool-toggle">
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Background" Value="#252525" />
            <Setter Property="BorderBrush" Value="#333333" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Foreground" Value="#CCCCCC" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="ToggleButton.tool-toggle:checked">
            <Setter Property="Background" Value="#3E3E3E" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#555555" />
        </Style>

        <!-- Hide Avalonia's built-in Title text to prevent overlap with custom brand logo & menu -->
        <Style Selector="chrome|WindowDrawnDecorations">
            <Setter Property="Title" Value="" />
        </Style>
        <Style Selector="TextBlock#PART_Title">
            <Setter Property="IsVisible" Value="False" />
            <Setter Property="Width" Value="0" />
            <Setter Property="Height" Value="0" />
            <Setter Property="Opacity" Value="0" />
        </Style>

        <!-- Hide Avalonia's built-in FullScreen button -->
        <Style Selector="Button#PART_FullScreenButton">
            <Setter Property="IsVisible" Value="False" />
            <Setter Property="Width" Value="0" />
            <Setter Property="Height" Value="0" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsEnabled" Value="False" />
        </Style>
        <Style Selector="Button[(chrome|WindowDecorationProperties.ElementRole)=FullScreenButton]">
            <Setter Property="IsVisible" Value="False" />
            <Setter Property="Width" Value="0" />
            <Setter Property="Height" Value="0" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsEnabled" Value="False" />
        </Style>
    </Window.Styles>

    <DockPanel>
        <!-- ================================================================= -->
        <!-- ROW 0: INTEGRATED TITLE BAR & MENU BAR                            -->
        <!-- Margin="0,0,140,0" leaves room for CaptionButtons (Min, Max, Close) -->
        <!-- ================================================================= -->
        <Grid DockPanel.Dock="Top" Height="30" Background="#141414">
            <Border BorderBrush="#242424" BorderThickness="0,0,0,1">
                <Grid Margin="0,0,140,0">
                    <Grid.ColumnDefinitions>
                        <!-- Left: Brand Logo & Main Menu -->
                        <ColumnDefinition Width="Auto" />
                        <!-- Center: Draggable Window Region & Current Scene Name -->
                        <ColumnDefinition Width="*" />
                        <!-- Right: Quick Build & Active Configuration -->
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Brand Logo & Integrated Menu Bar -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="8,0,0,0">
                        <Border Background="#222222" BorderBrush="#2E2E2E" BorderThickness="1"
                                CornerRadius="3" Padding="5,2" VerticalAlignment="Center"
                                chrome:WindowDecorationProperties.ElementRole="TitleBar"
                                PointerPressed="OnTitleBarPointerPressed">
                            <TextBlock Text="IGNITE" FontWeight="Bold" FontSize="10" Foreground="#E0E0E0" VerticalAlignment="Center" />
                        </Border>

                        <TextBlock Text="|" Foreground="#333333" FontSize="11" VerticalAlignment="Center" Margin="2,0" />

                        <!-- Integrated Menu (ElementRole=User ensures hover & clicks work) -->
                        <Menu FontSize="11" Margin="0" Padding="0" VerticalAlignment="Center" Background="Transparent"
                              chrome:WindowDecorationProperties.ElementRole="User">
                            <!-- File -->
                            <MenuItem Header="_File">
                                <MenuItem Header="New Scene" Command="{Binding NewSceneCommand}" InputGesture="Ctrl+N" />
                                <MenuItem Header="Open Scene" Command="{Binding OpenSceneCommand}" InputGesture="Ctrl+O" />
                                <MenuItem Header="Save Scene" Command="{Binding SaveSceneCommand}" InputGesture="Ctrl+S" />
                                <Separator />
                                <MenuItem Header="New Project" Command="{Binding NewProjectCommand}" />
                                <MenuItem Header="Open Project" Command="{Binding OpenProjectCommand}" />
                                <MenuItem Header="Save Project" Command="{Binding SaveProjectCommand}" />
                            </MenuItem>
                            <!-- Edit -->
                            <MenuItem Header="_Edit">
                                <MenuItem Header="Undo" InputGesture="Ctrl+Z" IsEnabled="False" />
                                <MenuItem Header="Redo" InputGesture="Ctrl+Y" IsEnabled="False" />
                                <Separator />
                                <MenuItem Header="Toggle Vsync" />
                                <MenuItem Header="Screenshot" />
                            </MenuItem>
                            <!-- View -->
                            <MenuItem Header="_View">
                                <MenuItem Header="Add Content Browser" />
                                <MenuItem Header="Game View" />
                                <MenuItem Header="Settings" />
                                <MenuItem Header="Asset Registry" />
                            </MenuItem>
                            <!-- Script -->
                            <MenuItem Header="_Script">
                                <MenuItem Header="Build Solution" Command="{Binding BuildSolutionCommand}" />
                                <MenuItem Header="Active Configuration">
                                    <MenuItem Header="Debug" Command="{Binding SetConfigurationCommand}" CommandParameter="Debug" />
                                    <MenuItem Header="Release" Command="{Binding SetConfigurationCommand}" CommandParameter="Release" />
                                    <MenuItem Header="Shipping" Command="{Binding SetConfigurationCommand}" CommandParameter="Shipping" />
                                </MenuItem>
                            </MenuItem>
                        </Menu>
                    </StackPanel>

                    <!-- Center: Draggable Window Region & Centered Scene Title -->
                    <Border Grid.Column="1" Background="Transparent" 
                            chrome:WindowDecorationProperties.ElementRole="TitleBar"
                            PointerPressed="OnTitleBarPointerPressed">
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Background="#1A1A1A" BorderBrush="#282828" BorderThickness="1"
                                    CornerRadius="3" Padding="8,2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="🎬" FontSize="10" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding CurrentSceneName}" FontSize="11" FontWeight="SemiBold" 
                                               Foreground="#A8A8A8" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" MaxWidth="350"
                                               ToolTip.Tip="{Binding CurrentSceneName}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Right: Active Configuration & Quick Build -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" Margin="4,0,8,0"
                                chrome:WindowDecorationProperties.ElementRole="User">
                        <!-- Active Solution Configuration Selector -->
                        <Button Classes="tool-btn" Height="22" Padding="6,1" FontSize="10"
                                ToolTip.Tip="Active Solution Configuration">
                            <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                    <MenuItem Header="Debug" Command="{Binding SetConfigurationCommand}" CommandParameter="Debug" />
                                    <MenuItem Header="Release" Command="{Binding SetConfigurationCommand}" CommandParameter="Release" />
                                    <MenuItem Header="Shipping" Command="{Binding SetConfigurationCommand}" CommandParameter="Shipping" />
                                </MenuFlyout>
                            </Button.Flyout>
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ActiveConfiguration}" FontSize="10" Foreground="#CCCCCC" VerticalAlignment="Center" />
                                <TextBlock Text="▾" FontSize="8" Foreground="#888888" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Quick Build Button -->
                        <Button Content="🔨 Build" Command="{Binding BuildSolutionCommand}"
                                Classes="tool-btn" Height="22" Padding="6,1" FontSize="10"
                                ToolTip.Tip="Build Solution" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ================================================================= -->
        <!-- ROW 2: EXPANDED TOOLBAR WITH COMPREHENSIVE ENGINE TOOLS           -->
        <!-- ================================================================= -->
        <Border DockPanel.Dock="Top" Background="#1E1E1E"
                Padding="6,3" Height="34" BorderBrush="#262626"
                BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <!-- Left Section: Play Controls & Transform Gizmos -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                    
                    <!-- Coordinate System Toggle -->
                    <Button Content="{Binding CoordinateSpaceText}" 
                            Command="{Binding ToggleCoordinateSpaceCommand}"
                            Classes="tool-btn" Height="22" Padding="6,2" FontSize="11"
                            ToolTip.Tip="Toggle Coordinate Space (World / Local)" />

                    <!-- Snapping & Grid -->
                    <ToggleButton Content="Snap" IsChecked="{Binding SnapEnabled}"
                                  Classes="tool-toggle" Height="22" Padding="6,2" FontSize="11"
                                  ToolTip.Tip="Toggle Grid/Rotation Snapping" />

                    <ToggleButton Content="Grid" IsChecked="{Binding ShowGrid}"
                                  Classes="tool-toggle" Height="22" Padding="6,2" FontSize="11"
                                  ToolTip.Tip="Toggle Viewport Grid" />

                    <Border Width="1" Background="#2A2A2A" Margin="4,2" />
                    
                    <!-- Transform Gizmo Tools -->
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button Content="Translate" Command="{Binding SetGizmoCommand}" CommandParameter="Translate"
                                Classes="tool-btn" FontSize="12" MinWidth="26" Height="22" Padding="4,1"
                                ToolTip.Tip="Translate Tool (W)" />
                        <Button Content="Rotate" Command="{Binding SetGizmoCommand}" CommandParameter="Rotate"
                                Classes="tool-btn" FontSize="12" MinWidth="26" Height="22" Padding="4,1"
                                ToolTip.Tip="Rotate Tool (E)" />
                        <Button Content="Scale" Command="{Binding SetGizmoCommand}" CommandParameter="Scale"
                                Classes="tool-btn" FontSize="12" MinWidth="26" Height="22" Padding="4,1"
                                ToolTip.Tip="Scale Tool (R)" />
                        <Button Content="Bound 2D" Command="{Binding SetGizmoCommand}" CommandParameter="BoundSizing2D"
                                Classes="tool-btn" FontSize="12" MinWidth="26" Height="22" Padding="4,1"
                                ToolTip.Tip="2D Bounds Tool (T)" />
                    </StackPanel>

                    <Border Width="1" Background="#2A2A2A" Margin="4,2" />

                    <!-- Scene Playback Controls -->
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button Content="Play" Command="{Binding PlayCommand}" Background="Green"
                                Classes="tool-btn" FontSize="12" MinWidth="26" Height="22" Padding="4,1"
                                ToolTip.Tip="Play Scene" />
                        <Button Content="Pause" Command="{Binding PauseCommand}" 
                                Classes="tool-btn" FontSize="12" MinWidth="26" Height="22" Padding="4,1"
                                ToolTip.Tip="Pause Scene" />
                        <Button Content="Stop" Command="{Binding StopCommand}" 
                                Classes="tool-btn" FontSize="12" MinWidth="26" Height="22" Padding="4,1"
                                ToolTip.Tip="Stop Scene" />
                        <Button Content="Step" Command="{Binding StepCommand}" 
                                Classes="tool-btn" FontSize="10" MinWidth="24" Height="22" Padding="4,1"
                                ToolTip.Tip="Step 1 Frame" />
                        <Button Content="Simulate" Command="{Binding SimulateCommand}" 
                                Classes="tool-btn" FontSize="11" MinWidth="24" Height="22" Padding="4,1"
                                ToolTip.Tip="Simulate Physics" />
                    </StackPanel>

                </StackPanel>

                

                <!-- Right Section: State & Diagnostics Info -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="#161616" CornerRadius="3" Padding="8,3" BorderBrush="#2A2A2A" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock FontSize="10" Foreground="#888888" Text="State:" VerticalAlignment="Center" />
                            <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="#E0E0E0" Text="{Binding PlayState}" VerticalAlignment="Center" />
                            <TextBlock FontSize="10" Foreground="#444444" Text="|" VerticalAlignment="Center" />
                            <TextBlock FontSize="10" Foreground="#888888" Text="Gizmo:" VerticalAlignment="Center" />
                            <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="#E0E0E0" Text="{Binding ActiveGizmo}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ================================================================= -->
        <!-- ROW 4: STATUS BAR AT BOTTOM                                       -->
        <!-- ================================================================= -->
        <Border DockPanel.Dock="Bottom" Background="#141414" Padding="8,4" Height="32"
                BorderBrush="#242424" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                <!-- Status text -->
                <TextBlock Grid.Column="0" Text="{Binding StatusText}" 
                           FontSize="11" Foreground="#999999" VerticalAlignment="Center" />
                
                <!-- Loading progress -->
                <ProgressBar Grid.Column="1" Value="{Binding LoadingProgress}" 
                             Maximum="1.0" Width="100" Height="6" 
                             Margin="8,0" VerticalAlignment="Center"
                             IsVisible="{Binding LoadingProgress}" />

                <Border Grid.Column="2" />

                <!-- Version -->
                <TextBlock Grid.Column="4" Text="Ignite Engine v0.1.0" 
                           FontSize="11" Foreground="#999999" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- ================================================================= -->
        <!-- ROW 3: MAIN EDITOR DOCK/PANEL CONTENT                             -->
        <!-- ================================================================= -->
        <Grid ColumnDefinitions="220,3,*,3,330" Background="#161616">
            <!-- Left: Scene Hierarchy -->
            <Border Grid.Column="0" Background="#1E1E1E">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#222222" Padding="6,4"
                            BorderBrush="#262626" BorderThickness="0,0,0,1">
                        <TextBlock Text="Hierarchy" FontSize="11" FontWeight="SemiBold" Foreground="#B0B0B0" />
                    </Border>
                    <panels:SceneHierarchyPanel DataContext="{Binding SceneHierarchy}" />
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="3" Background="#242424" />

            <!-- Center: Viewport + Bottom panels -->
            <Grid Grid.Column="2" RowDefinitions="*,3,280">
                <!-- Viewport -->
                <Border Grid.Row="0" Background="#181818">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="#222222" Padding="6,4"
                                BorderBrush="#262626" BorderThickness="0,0,0,1">
                            <TextBlock Text="Viewport" FontSize="11" FontWeight="SemiBold" Foreground="#B0B0B0" />
                        </Border>
                        <panels:ViewportPanel DataContext="{Binding Viewport}" />
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Row="1" Height="3" Background="#242424" />

                <!-- Bottom tabbed panels: Content Browser + Console -->
                <Border Grid.Row="2" Background="#1E1E1E">
                    <TabControl Padding="0" FontSize="11">
                        <TabItem Header="Content Browser" FontSize="11" Padding="8,3">
                            <panels:ContentBrowserPanel DataContext="{Binding ContentBrowser}" />
                        </TabItem>
                        <TabItem Header="Console" FontSize="11" Padding="8,3">
                            <panels:ConsolePanel DataContext="{Binding Console}" />
                        </TabItem>
                    </TabControl>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="3" Width="3" Background="#242424" />

            <!-- Right: Properties -->
            <Border Grid.Column="4" Background="#1E1E1E">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#222222" Padding="6,4"
                            BorderBrush="#262626" BorderThickness="0,0,0,1">
                        <TextBlock Text="Properties" FontSize="11" FontWeight="SemiBold" Foreground="#B0B0B0" />
                    </Border>
                    <panels:PropertiesPanel DataContext="{Binding Properties}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
