<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:IgniteEditor.ViewModels"
        xmlns:panels="using:IgniteEditor.Views.Panels"
        xmlns:ctrl="using:IgniteEditor.Controls"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        mc:Ignorable="d" d:DesignWidth="1440" d:DesignHeight="880"
        x:Class="IgniteEditor.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title=""
        Width="1440" Height="880"
        MinWidth="960" MinHeight="540"
        Background="{DynamicResource IgniteMainBackgroundBrush}"
        Foreground="{DynamicResource IgniteTextPrimaryBrush}"
        WindowStartupLocation="CenterScreen"
        TransparencyLevelHint="Mica, AcrylicBlur"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="30">

    <Window.Styles>
        <!-- Toolbar Button Styling -->
        <Style Selector="Button.tool-btn">
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Foreground" Value="{DynamicResource IgniteTextPrimaryBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.tool-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorSecondaryBrush}" />
        </Style>
        <Style Selector="Button.tool-btn:pressed">
            <Setter Property="Background" Value="{DynamicResource IgniteAccentBrush}" />
            <Setter Property="Foreground" Value="#121417" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style Selector="ToggleButton.tool-toggle">
            <Setter Property="Height" Value="24" />
            <Setter Property="Width" Value="56" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Foreground" Value="{DynamicResource IgniteTextSecondaryBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="ToggleButton.tool-toggle /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="ToggleButton.tool-toggle:pointerover">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource IgniteTextPrimaryBrush}" />
        </Style>
        <Style Selector="ToggleButton.tool-toggle:checked">
            <Setter Property="Background" Value="{DynamicResource IgniteAccentBrush}" />
            <Setter Property="Foreground" Value="#121417" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="BorderBrush" Value="{DynamicResource IgniteAccentBrush}" />
        </Style>
        <Style Selector="ToggleButton.tool-toggle:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource IgniteAccentBrush}" />
            <Setter Property="Foreground" Value="#121417" />
            <Setter Property="BorderBrush" Value="{DynamicResource IgniteAccentBrush}" />
        </Style>
        <Style Selector="ToggleButton.tool-toggle:checked:pointerover">
            <Setter Property="Background" Value="{DynamicResource IgniteAccentHoverBrush}" />
            <Setter Property="Foreground" Value="#121417" />
            <Setter Property="BorderBrush" Value="{DynamicResource IgniteAccentHoverBrush}" />
        </Style>
        <Style Selector="ToggleButton.tool-toggle:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource IgniteAccentHoverBrush}" />
            <Setter Property="Foreground" Value="#121417" />
            <Setter Property="BorderBrush" Value="{DynamicResource IgniteAccentHoverBrush}" />
        </Style>
        <Style Selector="ToggleButton.tool-toggle:checked:pressed">
            <Setter Property="Background" Value="{DynamicResource IgniteAccentPressedBrush}" />
            <Setter Property="Foreground" Value="#121417" />
            <Setter Property="BorderBrush" Value="{DynamicResource IgniteAccentPressedBrush}" />
        </Style>
        <Style Selector="ToggleButton.tool-toggle:checked:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource IgniteAccentPressedBrush}" />
            <Setter Property="Foreground" Value="#121417" />
            <Setter Property="BorderBrush" Value="{DynamicResource IgniteAccentPressedBrush}" />
        </Style>
        <Style Selector="ToggleButton.tool-toggle:checked TextBlock">
            <Setter Property="Foreground" Value="#121417" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="ToggleButton.tool-toggle:checked PathIcon">
            <Setter Property="Foreground" Value="#121417" />
        </Style>
        <Style Selector="ToggleButton.tool-toggle:checked:pointerover TextBlock">
            <Setter Property="Foreground" Value="#121417" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="ToggleButton.tool-toggle:checked:pointerover PathIcon">
            <Setter Property="Foreground" Value="#121417" />
        </Style>
        <Style Selector="ToggleButton.tool-toggle:checked:pressed TextBlock">
            <Setter Property="Foreground" Value="#121417" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="ToggleButton.tool-toggle:checked:pressed PathIcon">
            <Setter Property="Foreground" Value="#121417" />
        </Style>

        <!-- Hide Avalonia's built-in Title text to prevent overlap with custom brand logo & menu -->
        <Style Selector="chrome|WindowDrawnDecorations">
            <Setter Property="Title" Value="" />
        </Style>
        <Style Selector="TextBlock#PART_Title">
            <Setter Property="IsVisible" Value="False" />
            <Setter Property="Width" Value="0" />
            <Setter Property="Height" Value="0" />
            <Setter Property="Opacity" Value="0" />
        </Style>

        <!-- Hide Avalonia's built-in FullScreen button -->
        <Style Selector="Button#PART_FullScreenButton">
            <Setter Property="IsVisible" Value="False" />
            <Setter Property="Width" Value="0" />
            <Setter Property="Height" Value="0" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsEnabled" Value="False" />
        </Style>
        <Style Selector="Button[(chrome|WindowDecorationProperties.ElementRole)=FullScreenButton]">
            <Setter Property="IsVisible" Value="False" />
            <Setter Property="Width" Value="0" />
            <Setter Property="Height" Value="0" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsEnabled" Value="False" />
        </Style>
    </Window.Styles>

    <DockPanel>
        <!-- ================================================================= -->
        <!-- ROW 0: INTEGRATED TITLE BAR & MENU BAR                            -->
        <!-- Margin="0,0,140,0" leaves room for CaptionButtons (Min, Max, Close) -->
        <!-- ================================================================= -->
        <Grid DockPanel.Dock="Top" Height="38" Background="{DynamicResource IgniteTitleBarGradient}">
            <Border BorderBrush="{DynamicResource IgniteBorderSubtleBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="0,0,140,0">
                    <Grid.ColumnDefinitions>
                        <!-- Left: Brand Logo & Main Menu -->
                        <ColumnDefinition Width="Auto" />
                        <!-- Center: Draggable Window Region & Current Scene Name -->
                        <ColumnDefinition Width="*" />
                        <!-- Right: Quick Build & Active Configuration -->
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Brand Logo & Integrated Menu Bar -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="8,0,0,0">
                        <!-- JetBrains Style Brand Gradient Pill -->
                        <Border Background="{DynamicResource IgniteAccentGradient}" 
                                CornerRadius="4" Padding="8,2" VerticalAlignment="Center"
                                BoxShadow="0 1 6 0 #4DD1FE17"
                                chrome:WindowDecorationProperties.ElementRole="TitleBar"
                                PointerPressed="OnTitleBarPointerPressed">
                            <TextBlock Text="IGNITE" FontSize="10" FontWeight="Bold" Foreground="#121417" VerticalAlignment="Center" />
                        </Border>

                        <TextBlock Text="|" Foreground="{DynamicResource IgniteBorderBrush}" FontSize="11" VerticalAlignment="Center" Margin="2,0" />

                        <!-- Integrated Menu (ElementRole=User ensures hover & clicks work) -->
                        <Menu FontSize="11" Margin="0" Padding="0" VerticalAlignment="Center" Background="Transparent"
                              chrome:WindowDecorationProperties.ElementRole="User">
                            <!-- File -->
                            <MenuItem Header="_File">
                                <MenuItem Header="New Scene" Command="{Binding NewSceneCommand}" InputGesture="Ctrl+N" />
                                <MenuItem Header="Open Scene" Command="{Binding OpenSceneCommand}" InputGesture="Ctrl+O" />
                                <MenuItem Header="Save Scene" Command="{Binding SaveSceneCommand}" InputGesture="Ctrl+S" />
                                <MenuItem Header="Save Scene As" Command="{Binding SaveSceneAsCommand}" InputGesture="Ctrl+Shift+S" />
                                <Separator />
                                <MenuItem Header="New Project" Command="{Binding NewProjectCommand}" />
                                <MenuItem Header="Open Project" Command="{Binding OpenProjectCommand}" />
                                <MenuItem Header="Save Project" Command="{Binding SaveProjectCommand}" />
                                <MenuItem Header="Close Project" Command="{Binding CloseProjectCommand}" />
                            </MenuItem>
                            <!-- Edit -->
                            <MenuItem Header="_Edit">
                                <MenuItem Header="Undo" InputGesture="Ctrl+Z" IsEnabled="False" />
                                <MenuItem Header="Redo" InputGesture="Ctrl+Y" IsEnabled="False" />
                                <Separator />
                                <MenuItem Header="Toggle Vsync" />
                                <MenuItem Header="Screenshot" />
                            </MenuItem>
                            <!-- View -->
                            <MenuItem Header="_View">
                                <MenuItem Header="Add Content Browser" />
                                <MenuItem Header="Game View" />
                                <MenuItem Header="Settings" />
                                <MenuItem Header="Asset Registry" />
                            </MenuItem>
                            <!-- Script -->
                            <MenuItem Header="_Script">
                                <MenuItem Header="Build Solution" Command="{Binding BuildSolutionCommand}" />
                                <MenuItem Header="Active Configuration">
                                    <MenuItem Header="Debug" Command="{Binding SetConfigurationCommand}" CommandParameter="Debug" />
                                    <MenuItem Header="Release" Command="{Binding SetConfigurationCommand}" CommandParameter="Release" />
                                    <MenuItem Header="Shipping" Command="{Binding SetConfigurationCommand}" CommandParameter="Shipping" />
                                </MenuItem>
                            </MenuItem>
                        </Menu>
                    </StackPanel>

                    <!-- Center: Draggable Window Region & Centered Scene Title -->
                    <Border Grid.Column="1" Background="Transparent" 
                            chrome:WindowDecorationProperties.ElementRole="TitleBar"
                            PointerPressed="OnTitleBarPointerPressed">
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Background="{DynamicResource IgniteGlassBackgroundBrush}" 
                                    BorderBrush="{DynamicResource IgniteBorderSubtleBrush}" BorderThickness="1"
                                    CornerRadius="4" Padding="8,2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <PathIcon Data="{StaticResource IconScene}" Width="11" Height="11" Foreground="{DynamicResource IgniteAccentBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding CurrentSceneName}" FontSize="11" FontWeight="Medium" 
                                               Foreground="{DynamicResource IgniteTextPrimaryBrush}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" MaxWidth="350"
                                               ToolTip.Tip="{Binding CurrentSceneName}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Right: Active Configuration & Quick Build -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" Margin="4,0,8,0"
                                chrome:WindowDecorationProperties.ElementRole="User">
                        <!-- Active Solution Configuration Selector -->
                        <Button Classes="tool-btn" Height="22" Padding="6,1" FontSize="10"
                                ToolTip.Tip="Active Solution Configuration">
                            <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                    <MenuItem Header="Debug" Command="{Binding SetConfigurationCommand}" CommandParameter="Debug" />
                                    <MenuItem Header="Release" Command="{Binding SetConfigurationCommand}" CommandParameter="Release" />
                                    <MenuItem Header="Shipping" Command="{Binding SetConfigurationCommand}" CommandParameter="Shipping" />
                                </MenuFlyout>
                            </Button.Flyout>
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ActiveConfiguration}" FontSize="10" Foreground="{DynamicResource IgniteTextPrimaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="▾" FontSize="8" Foreground="{DynamicResource IgniteTextMutedBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Quick Build Button -->
                        <Button Command="{Binding BuildSolutionCommand}"
                                Classes="tool-btn" Height="22" Padding="6,1" FontSize="10"
                                ToolTip.Tip="Build Solution">
                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                <PathIcon Data="{StaticResource IconBuild}" Width="10" Height="10" Foreground="{DynamicResource IgniteAccentBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="Build" FontSize="10" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ================================================================= -->
        <!-- ROW 2: EXPANDED TOOLBAR WITH COMPREHENSIVE ENGINE TOOLS           -->
        <!-- ================================================================= -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource IgniteGlassPanelBrush}"
                Padding="6,3" Height="34" BorderBrush="{DynamicResource IgniteBorderBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <!-- Left Section: Play Controls & Transform Gizmos -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                    
                    <!-- Coordinate System Toggle -->
                    <Button Content="{Binding CoordinateSpaceText}" 
                            Command="{Binding ToggleCoordinateSpaceCommand}"
                            Classes="tool-btn" Height="22" Padding="6,2" FontSize="11" Width="56"
                            ToolTip.Tip="Toggle Coordinate Space (World / Local)" />

                    <!-- Snapping & Grid -->
                    <ToggleButton IsChecked="{Binding SnapEnabled}"
                                  Classes="tool-toggle" Height="22" Padding="6,2" FontSize="11"
                                  ToolTip.Tip="Toggle Grid/Rotation Snapping">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource IconSnap}" Width="10" Height="10" VerticalAlignment="Center" />
                            <TextBlock Text="Snap" VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>

                    <!-- Individual Snap Value for Active Gizmo Operation -->
                    <ctrl:NumericDragBox Value="{Binding SnapValue, Mode=TwoWay}"
                                         IsEnabled="{Binding SnapEnabled}"
                                         Step="0.1" Minimum="0.001" Maximum="360"
                                         Format="0.##" Width="52" Height="22"
                                         Margin="1,0"
                                         ToolTip.Tip="Snap Value for Active Operation (Translate / Rotate / Scale)" />

                    <ToggleButton IsChecked="{Binding ShowGrid}"
                                  Classes="tool-toggle" Height="22" Padding="6,2" FontSize="11"
                                  ToolTip.Tip="Toggle Viewport Grid">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource IconGrid}" Width="10" Height="10" VerticalAlignment="Center" />
                            <TextBlock Text="Grid" VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>

                    <Border Width="1" Background="{DynamicResource IgniteBorderSubtleBrush}" Margin="4,2" />
                    
                    <!-- Transform Gizmo Tools. None is the safe default/picking mode. -->
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <ToggleButton IsChecked="{Binding IsNoneActive, Mode=OneWay}"
                                      Command="{Binding SetGizmoCommand}" CommandParameter="None"
                                      Classes="tool-toggle" Width="26" Height="22" Padding="6,1"
                                      ToolTip.Tip="Selection Tool (Mouse Picking)">
                            <PathIcon Data="{StaticResource IconSelect}" Width="12" Height="12" />
                        </ToggleButton>
                        <ToggleButton IsChecked="{Binding IsTranslateActive, Mode=OneWay}"
                                      Command="{Binding SetGizmoCommand}" CommandParameter="Translate"
                                      Classes="tool-toggle" Width="26" Height="22" Padding="6,1"
                                      ToolTip.Tip="Translate Tool (W)">
                            <PathIcon Data="{StaticResource IconTranslate}" Width="12" Height="12" />
                        </ToggleButton>
                        <ToggleButton IsChecked="{Binding IsRotateActive, Mode=OneWay}"
                                      Command="{Binding SetGizmoCommand}" CommandParameter="Rotate"
                                      Classes="tool-toggle" Width="26" Height="22" Padding="6,1"
                                      ToolTip.Tip="Rotate Tool (E)">
                            <PathIcon Data="{StaticResource IconRotate}" Width="12" Height="12" />
                        </ToggleButton>
                        <ToggleButton IsChecked="{Binding IsScaleActive, Mode=OneWay}"
                                      Command="{Binding SetGizmoCommand}" CommandParameter="Scale"
                                      Classes="tool-toggle" Width="26" Height="22" Padding="6,1"
                                      ToolTip.Tip="Scale Tool (R)">
                            <PathIcon Data="{StaticResource IconScale}" Width="12" Height="12" />
                        </ToggleButton>
                    </StackPanel>

                    <Border Width="1" Background="{DynamicResource IgniteBorderSubtleBrush}" Margin="4,2" />

                    <!-- Scene Playback Controls: [Play/Stop, Simulate/Stop, Pause, Step] -->
                    <StackPanel Orientation="Horizontal" Spacing="3">
                        <Button Content="{Binding PlayButtonText}" Command="{Binding PlayCommand}" 
                                Classes="tool-btn" FontSize="11" FontWeight="Bold" Height="22" Padding="8,1"
                                Foreground="{DynamicResource IgniteAccentBrush}"
                                ToolTip.Tip="Play / Stop Scene" />
                        <Button Content="{Binding SimulateButtonText}" Command="{Binding SimulateCommand}" 
                                Classes="tool-btn" FontSize="11" FontWeight="Bold" Height="22" Padding="8,1"
                                Foreground="{DynamicResource IgniteAccentBrush}"
                                ToolTip.Tip="Simulate Physics / Stop" />
                        <Button Content="{Binding PauseButtonText}" Command="{Binding PauseCommand}" 
                                Classes="tool-btn" FontSize="11" Height="22" Padding="6,1"
                                ToolTip.Tip="Pause / Resume Scene" />
                        <Button Command="{Binding StepCommand}" 
                                Classes="tool-btn" FontSize="11" Height="22" Padding="6,1"
                                ToolTip.Tip="Step Simulation 1 Frame">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <PathIcon Data="{StaticResource IconStep}" Width="9" Height="9" Foreground="{DynamicResource IgniteTextSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="Step" FontSize="11" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!-- Right Section: State & Diagnostics Info -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="{DynamicResource IgniteGlassBackgroundBrush}" CornerRadius="4" Padding="8,3" 
                            BorderBrush="{DynamicResource IgniteBorderSubtleBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock FontSize="10" Foreground="{DynamicResource IgniteTextMutedBrush}" Text="State:" VerticalAlignment="Center" />
                            <TextBlock FontSize="10" FontWeight="Bold" Foreground="{DynamicResource IgniteAccentBrush}" Text="{Binding PlayState}" VerticalAlignment="Center" />
                            <TextBlock FontSize="10" Foreground="{DynamicResource IgniteBorderBrush}" Text="|" VerticalAlignment="Center" />
                            <TextBlock FontSize="10" Foreground="{DynamicResource IgniteTextMutedBrush}" Text="Gizmo:" VerticalAlignment="Center" />
                            <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource IgniteTextPrimaryBrush}" Text="{Binding ActiveGizmo}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ================================================================= -->
        <!-- ROW 4: STATUS BAR AT BOTTOM                                       -->
        <!-- ================================================================= -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource IgniteGlassHeaderBrush}" Padding="8,4" Height="30"
                BorderBrush="{DynamicResource IgniteBorderSubtleBrush}" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                <!-- Status text -->
                <TextBlock Grid.Column="0" Text="{Binding StatusText}" 
                           FontSize="11" Foreground="{DynamicResource IgniteTextSecondaryBrush}" VerticalAlignment="Center" />
                
                <!-- Loading progress -->
                <ProgressBar Grid.Column="1" Value="{Binding LoadingProgress}" 
                             Maximum="1.0" Width="100" Height="6" 
                             Margin="8,0" VerticalAlignment="Center"
                             IsVisible="{Binding LoadingProgress}" />

                <Border Grid.Column="2" />

                <!-- Version with Subtle Lime Accent -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Ellipse Width="6" Height="6" Fill="{DynamicResource IgniteAccentBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="Ignite Engine v0.1.0" 
                               FontSize="11" Foreground="{DynamicResource IgniteTextMutedBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================================================================= -->
        <!-- ROW 3: MAIN EDITOR DOCK/PANEL CONTENT                             -->
        <!-- ================================================================= -->
        <Grid ColumnDefinitions="220,3,*,3,330" Background="{DynamicResource IgniteMainBackgroundBrush}">
            <!-- Left: Scene Hierarchy -->
            <Border Grid.Column="0" Background="{DynamicResource IgnitePanelBackgroundBrush}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{DynamicResource IgnitePanelHeaderGradient}" Padding="8,5"
                            BorderBrush="{DynamicResource IgniteBorderSubtleBrush}" BorderThickness="0,0,0,1">
                        <TextBlock Text="Hierarchy" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource IgniteTextPrimaryBrush}" />
                    </Border>
                    <panels:SceneHierarchyPanel DataContext="{Binding SceneHierarchy}" />
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="3" Background="{DynamicResource IgniteBorderSubtleBrush}" />

            <!-- Center: Viewport + Bottom panels -->
            <Grid Grid.Column="2" RowDefinitions="*,3,280">
                <!-- Viewport -->
                <Border Grid.Row="0" Background="{DynamicResource IgniteSidebarBackgroundBrush}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="{DynamicResource IgnitePanelHeaderGradient}" Padding="8,5"
                                BorderBrush="{DynamicResource IgniteBorderSubtleBrush}" BorderThickness="0,0,0,1">
                            <TextBlock Text="Viewport" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource IgniteTextPrimaryBrush}" />
                        </Border>
                        <panels:ViewportPanel DataContext="{Binding Viewport}" />
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Row="1" Height="3" Background="{DynamicResource IgniteBorderSubtleBrush}" />

                <!-- Bottom tabbed panels: Content Browser + Console -->
                <Border Grid.Row="2" Background="{DynamicResource IgnitePanelBackgroundBrush}">
                    <TabControl Padding="0" FontSize="11">
                        <TabItem Header="Content Browser" FontSize="11" Padding="10,4">
                            <panels:ContentBrowserPanel DataContext="{Binding ContentBrowser}" />
                        </TabItem>
                        <TabItem Header="Console" FontSize="11" Padding="10,4">
                            <panels:ConsolePanel DataContext="{Binding Console}" />
                        </TabItem>
                    </TabControl>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="3" Width="3" Background="{DynamicResource IgniteBorderSubtleBrush}" />

            <!-- Right: Properties -->
            <Border Grid.Column="4" Background="{DynamicResource IgnitePanelBackgroundBrush}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{DynamicResource IgnitePanelHeaderGradient}" Padding="8,5"
                            BorderBrush="{DynamicResource IgniteBorderSubtleBrush}" BorderThickness="0,0,0,1">
                        <TextBlock Text="Properties" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource IgniteTextPrimaryBrush}" />
                    </Border>
                    <panels:PropertiesPanel DataContext="{Binding Properties}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
