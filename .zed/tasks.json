[
  {
    "label": "Generate Solutions (Premake5)",
    "command": "premake5 vs2026 --file=scripts/premake5.lua",
    "use_new_terminal": false,
    "allow_concurrent_runs": false
  },
  {
    "label": "Build Editor (Debug)",
    "command": "msbuild IGN.slnx /t:Ignite_Editor /p:Configuration=Debug /p:Platform=\"x64\"",
    "use_new_terminal": false,
    "allow_concurrent_runs": false
  },
  {
    "label": "Run Editor (No Debugger)",
    "command": "bin/Debug/Ignite.Editor.exe",
    "cwd": "ignite/editor",
    "use_new_terminal": false,
    "allow_concurrent_runs": false
  },
  {
    "label": "Build Editor (Release)",
    "command": "msbuild IGN.slnx /t:Ignite_Editor /p:Configuration=Release /p:Platform=\"x64\"",
    "use_new_terminal": false,
    "allow_concurrent_runs": false
  },
  {
    "label": "Build Test (Debug)",
    "command": "msbuild IGN.slnx /t:Ignite_Test /p:Configuration=Debug /p:Platform=\"x64\"",
    "use_new_terminal": false,
    "allow_concurrent_runs": false
  },
  {
    "label": "Build Solution (Debug)",
    "command": "msbuild IGN.slnx /t:Build /p:Configuration=Debug /p:Platform=\"x64\"",
    "use_new_terminal": false,
    "allow_concurrent_runs": false
  },
  {
    "label": "Build Solution (Release)",
    "command": "msbuild IGN.slnx /t:Build /p:Configuration=Release /p:Platform=\"x64\"",
    "use_new_terminal": false,
    "allow_concurrent_runs": false
  },
  {
    "label": "Cargo Build (Debug)",
    "command": "cargo build --manifest-path crates/Cargo.toml",
    "use_new_terminal": false,
    "allow_concurrent_runs": false
  },
  {
    "label": "Cargo Build (Release)",
    "command": "cargo build --manifest-path crates/Cargo.toml --release",
    "use_new_terminal": false,
    "allow_concurrent_runs": false
  },
  {
    "label": "Build C# ScriptEngine",
    "command": "dotnet build scriptengine/Ignite.ScriptEngine.csproj -c Debug",
    "use_new_terminal": false,
    "allow_concurrent_runs": false
  }
]
